<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    {% render 'color-schemes' %}
    {% render 'head' %}
  </head>

  <body class="template-{{ request.page_type }} flex flex-column">
    {%- comment -%}
      theme.js defines window.theme's shared utilities (debounce, toast,
      slider, etc.) that section-specific scripts depend on (e.g.
      assets/cart-field.js). It must be the first deferred script in
      document order so it always finishes before those - deferred scripts
      run in source order after parsing, regardless of where in the page
      the section that needs them ends up (header-group, footer-group, or
      main content).
    {%- endcomment -%}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>

    <script>
      window.theme = window.theme || {};
      window.theme.routes = {
        cartAdd: '{{ routes.cart_add_url }}.js',
        cartChange: '{{ routes.cart_change_url }}.js',
        cartUpdate: '{{ routes.cart_update_url }}.js',
        cart: '{{ routes.cart_url }}.js'
      };
      window.theme.strings = {
        addedToCart: {{ 'products.product.added_to_cart' | t | json }},
        addToCartError: {{ 'products.product.add_to_cart_error' | t | json }},
        lineErrorGeneric: {{ 'cart.line_error_generic' | t | json }}
      };
    </script>

    <script src="{{ 'variables.js' | asset_url }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
  </body>
</html>
