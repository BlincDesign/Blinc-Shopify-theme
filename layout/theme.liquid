<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
    />

    {% render 'color-schemes' %}
    {% render 'head' %}
  </head>

  <body class="template-{{ request.page_type }} flex flex-column">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>

    <quick-modal data-error-text="{{ 'products.product.load_error' | t }}">
      <dialog class="quick-modal" aria-label="{{ 'products.product.quick_view' | t }}">
        <button
          type="button"
          class="quick-modal__close"
          data-quick-modal-close
          aria-label="{{ 'general.accessibility.close' | t }}"
        >
          {%- render 'icon', name: 'close' -%}
        </button>
        <div class="quick-modal__body" data-quick-modal-body></div>
        <p class="quick-modal__loading text-body" data-quick-modal-loading hidden>
          {{- 'products.product.loading' | t -}}
        </p>
      </dialog>
    </quick-modal>

    <cart-drawer data-cart-url="{{ routes.cart_url }}">
      <dialog class="cart-drawer" aria-label="{{ 'cart.title' | t }}">
        <div class="cart-drawer__header flex items-center justify-between">
          <h2 class="cart-drawer__title heading heading--small">{{ 'cart.title' | t }}</h2>
          <button
            type="button"
            class="cart-drawer__close"
            data-cart-drawer-close
            aria-label="{{ 'general.accessibility.close' | t }}"
          >
            {%- render 'icon', name: 'close' -%}
          </button>
        </div>
        <div class="cart-drawer__body" data-cart-drawer-body></div>
        <p class="cart-drawer__loading text-body" data-cart-drawer-loading hidden>
          {{- 'products.product.loading' | t -}}
        </p>
      </dialog>
    </cart-drawer>

    <script>
      window.theme = window.theme || {};
      window.theme.routes = {
        cartAdd: '{{ routes.cart_add_url }}.js',
        cartChange: '{{ routes.cart_change_url }}.js',
        cartUpdate: '{{ routes.cart_update_url }}.js',
        cart: '{{ routes.cart_url }}.js'
      };
      window.theme.strings = {
        addedToCart: {{ 'products.product.added_to_cart' | t | json }},
        addToCartError: {{ 'products.product.add_to_cart_error' | t | json }},
        lineErrorGeneric: {{ 'cart.line_error_generic' | t | json }}
      };
    </script>

    <script src="{{ 'variables.js' | asset_url }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
