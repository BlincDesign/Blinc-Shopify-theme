{%- comment -%}
  Renders a compact "buy box" for a product: title, price, volume pricing,
  variant picker, quantity, and an add-to-cart button, wrapped in
  <product-info> - the same reusable component used on the product page.
  Fetched via sections/quick-view.liquid (?section_id=quick-view) and
  injected into the shared <quick-modal> by assets/quick-add.js.

  Accepts:
  product (object, required)
  show_gallery (boolean, optional) - Renders a media gallery above the form. Default: false.

  Usage:
  {% render 'quick-product-form', product: product, show_gallery: true %}
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'QuickForm-' | append: product.id
  assign quantity_input_id = 'QuickQuantity-' | append: product.id

  assign has_variant = false
  unless current_variant == null
    assign has_variant = true
  endunless

  assign quantity_min = 1
  assign quantity_max = 0
  assign quantity_increment = 1
  if has_variant
    assign quantity_min = current_variant.quantity_rule.min
    assign quantity_increment = current_variant.quantity_rule.increment
    if current_variant.quantity_rule.max != null
      assign quantity_max = current_variant.quantity_rule.max
    endif
    if current_variant.inventory_management == 'shopify' and current_variant.inventory_policy == 'deny'
      if quantity_max == 0 or current_variant.inventory_quantity < quantity_max
        assign quantity_max = current_variant.inventory_quantity
      endif
    endif
  endif

  assign quantity_rule_unavailable = false
  if has_variant and quantity_max > 0 and quantity_min > quantity_max
    assign quantity_rule_unavailable = true
  endif

  assign can_add_to_cart = false
  if has_variant and current_variant.available and quantity_rule_unavailable == false
    assign can_add_to_cart = true
  endif

  if has_variant == false
    assign buy_button_label = 'products.product.unavailable' | t
  elsif current_variant.available == false or quantity_rule_unavailable
    assign buy_button_label = 'products.product.sold_out' | t
  else
    assign buy_button_label = 'products.product.add_to_cart' | t
  endif
-%}

<div class="quick-product-form{% if show_gallery %} quick-product-form--with-media{% endif %}">
  {%- if show_gallery -%}
    <div class="quick-product-form__media">
      {%- if product.media.size > 1 -%}
        <div
          class="product__gallery-main"
          data-slider
          data-slider-config='{"loop": false, "slidesPerView": 1, "spaceBetween": 0}'
        >
          <div class="swiper-wrapper">
            {%- for media in product.media limit: 6 -%}
              {%- liquid
                assign media_loading = 'lazy'
                if forloop.first
                  assign media_loading = 'eager'
                endif
              -%}
              <div class="product__gallery-slide swiper-slide" data-media-id="{{ media.id }}">
                {%- render 'product-media-item',
                  media: media,
                  width: 800,
                  sizes: '(min-width: 750px) 420px, 90vw',
                  loading: media_loading
                -%}
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="product__gallery-btn product__gallery-btn--prev items-center justify-center"
            slider-prev
            aria-label="{{ 'products.product.previous_image' | t }}"
          >
            {%- render 'icon', name: 'chevron-left' -%}
          </button>
          <button
            type="button"
            class="product__gallery-btn product__gallery-btn--next items-center justify-center"
            slider-next
            aria-label="{{ 'products.product.next_image' | t }}"
          >
            {%- render 'icon', name: 'chevron-right' -%}
          </button>
        </div>
      {%- else -%}
        <div class="product__gallery-item" data-media-id="{{ product.featured_media.id }}">
          {%- render 'product-media-item', media: product.featured_media, width: 800, sizes: '(min-width: 750px) 420px, 90vw', loading: 'eager' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <product-info
    class="quick-product-form__info flex flex-column"
    data-update-url="false"
    data-section-id="{{ section.id }}"
    data-product-url="{{ product.url }}"
  >
    {%- form 'product', product, id: product_form_id, class: 'product__form flex flex-column' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

      {%- if product.vendor != blank -%}
        <p class="product__vendor text-body text-body--small">{{ product.vendor }}</p>
      {%- endif -%}

      <h2 class="product__title heading heading--small">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h2>

      {%- render 'product-price', product: product, variant: current_variant -%}

      {%- if product.quantity_price_breaks_configured? -%}
        {%- render 'volume-pricing', variant: current_variant -%}
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        {%- render 'variant-picker', product: product -%}
      {%- endunless -%}

      <p
        class="product__inventory text-body text-body--small"
        data-product-inventory
        data-state="{% if has_variant == false or current_variant.available == false or quantity_rule_unavailable %}out-of-stock{% else %}in-stock{% endif %}"
        {% if has_variant == false or current_variant.available and quantity_rule_unavailable == false %}hidden{% endif %}
      >
        {%- if has_variant == false -%}
        {%- elsif current_variant.available == false -%}
          {{ 'products.product.out_of_stock' | t }}
        {%- elsif quantity_rule_unavailable -%}
          {{ 'products.product.quantity_unavailable' | t | replace: '[min]', quantity_min | replace: '[count]', current_variant.inventory_quantity }}
        {%- endif -%}
      </p>

      <div class="product__quantity">
        <label class="text-body text-body--small" for="{{ quantity_input_id }}"> {{- 'products.product.quantity' | t -}}</label>

                  {%- liquid
                    assign quantity_disabled = true
                    if can_add_to_cart
                      assign quantity_disabled = false
                    endif
                  -%}

                  {%- render 'quantity-selector', id: quantity_input_id, min: quantity_min, max: quantity_max, step: quantity_increment, disabled: quantity_disabled
                  -%}
      </div>

      <div class="product__buy-buttons flex flex-column">
        {%- liquid
                    assign button_disabled = true
                    if can_add_to_cart
                      assign button_disabled = false
                    endif
                  -%}

                  {%- render 'button',
                        label: buy_button_label, type: 'submit', name: 'add', button_style: 'primary', class: 'product__atc-button', disabled: button_disabled
                  -%}
      </div>

      <a href="{{ product.url }}" class="quick-product-form__link text-body text-body--small">
        {{- 'products.product.view_full_details' | t -}}
      </a>
    {%- endform -%}
  </product-info>
</div>
