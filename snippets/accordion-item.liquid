{%- comment -%} A disclosure item; render inside <accordion-group>. Usage: render 'accordion-item', id:, title:, content:, open:, attributes: {%- endcomment -%}

{%- liquid
  assign trigger_id = 'AccordionTrigger-' | append: id
  assign panel_id = 'AccordionPanel-' | append: id
  assign open = open | default: false
-%}

<div class="accordion-item" {% if attributes != blank %}{{ attributes }}{% endif %}>
  <h3 class="accordion-item__header">
    <button
      type="button"
      class="accordion-item__trigger"
      id="{{ trigger_id }}"
      aria-expanded="{{ open }}"
      aria-controls="{{ panel_id }}"
    >
      <span class="accordion-item__title">{{ title }}</span>
      <span class="accordion-item__icon" aria-hidden="true">
        {%- render 'icon', name: 'plus' -%}
      </span>
    </button>
  </h3>
  <div
    class="accordion-item__panel{% if open %} accordion-item__panel--open{% endif %}"
    id="{{ panel_id }}"
    role="region"
    aria-labelledby="{{ trigger_id }}"
  >
    <div class="accordion-item__panel-inner">
      {{ content }}
    </div>
  </div>
</div>
