{%- comment -%}
  Renders progress toward settings.free_shipping_threshold. Renders
  nothing if the merchant hasn't set a threshold. Purely server-rendered -
  updates for free whenever the parent cart-drawer/cart-page section
  re-fetches after a cart change, no JS needed.

  Accepts:
  block (object, required) - a `free_shipping_progress` schema block.

  Usage:
  {% render 'free-shipping-progress', block: block %}
{%- endcomment -%}

{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0
-%}

{%- if threshold > 0 -%}
  {%- liquid
    assign threshold_cents = threshold | times: 100
    assign remaining_cents = threshold_cents | minus: cart.total_price
    assign has_reached_threshold = false
    if remaining_cents <= 0
      assign has_reached_threshold = true
    endif

    assign percent = 100
    unless has_reached_threshold
      assign percent = cart.total_price | times: 100 | divided_by: threshold_cents
    endunless

    assign remaining_money = remaining_cents | money
  -%}
  <div class="free-shipping-progress" {{ block.shopify_attributes }} data-state="{% if has_reached_threshold %}complete{% else %}in-progress{% endif %}">
    {%- if has_reached_threshold -%}
      <p class="free-shipping-progress__message text-body text-body--small flex items-center">
        {%- render 'icon', name: 'check', size: 16 -%}
        {{ block.settings.success_text }}
      </p>
    {%- else -%}
      <p class="free-shipping-progress__message text-body text-body--small">
        {{ block.settings.progress_text | replace: '[amount]', remaining_money }}
      </p>
    {%- endif -%}

    {%- if block.settings.show_bar -%}
      <div class="free-shipping-progress__bar">
        <div class="free-shipping-progress__bar-fill" style="width: {{ percent }}%;"></div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
