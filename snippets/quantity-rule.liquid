{%- comment -%}
  Computes a variant's quantity rule (min/max/increment, clamped against
  inventory policy) and renders snippets/quantity-selector.liquid with it.
  Liquid can't return computed values to a caller, so this snippet owns
  the full computation-to-markup path rather than exposing the numbers.

  sections/main-product.liquid and snippets/quick-product-form.liquid
  intentionally keep their own copy of this clamp - they also need the
  same numbers for inventory-message text and buy-button disabled state,
  not just the selector, so routing them through a selector-only snippet
  would either duplicate the computation anyway or pull unrelated
  concerns into this one.

  Accepts:
  variant (object, required)
  id (string, required) - passed through to quantity-selector.
  name (string, optional)
  value (number, optional)
  disabled (boolean, optional)

  Usage:
  {% render 'quantity-rule', variant: item.variant, id: 'CartQuantity-' | append: item.key, name: 'updates[' | append: item.key | append: ']', value: item.quantity %}
{%- endcomment -%}

{%- liquid
  assign quantity_min = variant.quantity_rule.min
  assign quantity_max = 0
  if variant.quantity_rule.max != null
    assign quantity_max = variant.quantity_rule.max
  endif
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    if quantity_max == 0 or variant.inventory_quantity < quantity_max
      assign quantity_max = variant.inventory_quantity
    endif
  endif
-%}

{%- render 'quantity-selector',
  id: id,
  name: name,
  value: value,
  min: quantity_min,
  max: quantity_max,
  step: variant.quantity_rule.increment,
  disabled: disabled
-%}
