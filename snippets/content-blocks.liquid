{%- comment -%}
  Accepts:
  block (object, required) - a block whose type is one of the above.

  Usage:
  {% render 'content-blocks', block: block %}
{%- endcomment -%}

{%- case block.type -%}
  {%- when 'heading' -%}
    {%- if block.settings.heading != blank -%}
      <h2 class="content-block__heading heading heading--{{ block.settings.heading_size }} column" {{ block.shopify_attributes }}>
        {{ block.settings.heading }}
      </h2>
    {%- endif -%}

  {%- when 'caption' -%}
    {%- if block.settings.caption != blank -%}
      <p class="content-block__caption text-subheading column" {{ block.shopify_attributes }}>{{ block.settings.caption }}</p>
    {%- endif -%}

  {%- when 'subheading' -%}
    {%- if block.settings.subheading != blank -%}
      <p class="content-block__subheading heading heading--small column" {{ block.shopify_attributes }}>
        {{ block.settings.subheading }}
      </p>
    {%- endif -%}

  {%- when 'image' -%}
    {%- if block.settings.image != blank -%}
      <div class="content-block__image column" {{ block.shopify_attributes }}>
        {%- render 'image',
          image: block.settings.image,
          width: 800,
          sizes: '(min-width: 750px) 50vw, 100vw',
          fill: false
        -%}
      </div>
    {%- endif -%}

  {%- when 'video' -%}
    {%- if block.settings.video != blank -%}
      <div class="content-block__video column" {{ block.shopify_attributes }}>
        {%- render 'video', video: block.settings.video, aspect_ratio: '16/9' -%}
      </div>
    {%- endif -%}

  {%- when 'divider' -%}
    <div class="content-block__divider column" {{ block.shopify_attributes }}>
      {%- if block.settings.divider_style == 'icon' and block.settings.divider_icon != blank -%}
        <span aria-hidden="true">
          {%- render 'icon',
            name: block.settings.divider_icon,
            size: block.settings.divider_icon_size,
            class: 'content-block__divider-icon'
          -%}
        </span>
      {%- else -%}
        <hr
          class="content-block__divider-line"
          style="--divider-width: {{ block.settings.divider_width | default: 100 }}%;"
        >
      {%- endif -%}
    </div>

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div
        class="content-block__text text-body{% if block.settings.text_size == 'small' %} text-body--small{% endif %} column"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </div>
    {%- endif -%}

  {%- when 'buttons' -%}
    {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
      <div class="content-block__buttons flex flex-wrap items-center column" {{ block.shopify_attributes }}>
        {%- if block.settings.button_1_label != blank -%}
          {%- render 'button',
            label: block.settings.button_1_label,
            url: block.settings.button_1_link,
            button_style: block.settings.button_1_style
          -%}
        {%- endif -%}
        {%- if block.settings.button_2_label != blank -%}
          {%- render 'button',
            label: block.settings.button_2_label,
            url: block.settings.button_2_link,
            button_style: block.settings.button_2_style
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'custom_liquid' -%}
    <div class="custom-liquid" {{ block.shopify_attributes }}>
      {{ block.settings.custom_liquid }}
    </div>
{%- endcase -%}
