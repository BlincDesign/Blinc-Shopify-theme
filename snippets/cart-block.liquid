{%- comment -%} Dispatches a cart-drawer/main-cart block to its renderer. Usage: render 'cart-block', block: {%- endcomment -%}

{%- case block.type -%}
  {%- when 'free_shipping_progress' -%}
    {%- render 'free-shipping-progress', block: block -%}
  {%- when 'minimum_order_message' -%}
    {%- render 'minimum-order-message', block: block -%}
  {%- when 'upsell_products' -%}
    {%- render 'upsell-products', block: block -%}
  {%- when 'discount_code' -%}
    {%- render 'discount-code', block: block -%}
  {%- when 'cart_note' -%}
    {%- render 'cart-note', block: block -%}
  {%- when 'po_reference' -%}
    {%- render 'po-reference', block: block -%}
  {%- when 'checkout_info' -%}
    {%- render 'checkout-info', block: block -%}
  {%- else -%}
    {%- render 'content-blocks', block: block -%}
{%- endcase -%}
