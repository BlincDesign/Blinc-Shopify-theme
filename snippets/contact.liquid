{% comment %}
  Reusable Contact Form

  Usage:
  {% render 'contact',
    show_name: true,
    show_email: true,
    show_phone: true,
    show_subject: true,
    show_message: true
  %}

  Available fields:
  - show_name
  - show_email
  - show_phone
  - show_subject
  - show_message
{% endcomment %}

{%- assign show_name = show_name | default: true -%}
{%- assign show_email = show_email | default: true -%}
{%- assign show_phone = show_phone | default: false -%}
{%- assign show_subject = show_subject | default: false -%}
{%- assign show_message = show_message | default: true -%}

{% form 'contact', class: 'contact-form' %}
  {% if form.posted_successfully? %}
    <div class="contact-form__success" role="status">
      {{ 'contact_form.post_success' | t }}
    </div>
  {% endif %}

  {{ form.errors | default_errors }}

  {% if show_name %}
    <div class="contact-form__field">
      <label for="ContactForm-name">{{ 'contact_form.name' | t }}</label>

      <input
        type="text"
        id="ContactForm-name"
        name="contact[name]"
        value="{{ form.name }}"
        autocomplete="name"
        placeholder="{{ 'contact_form.name' | t }}"
      >
    </div>
  {% endif %}

  {% if show_email %}
    <div class="contact-form__field">
      <label for="ContactForm-email">{{ 'contact_form.email' | t }}</label>

      <input
        type="email"
        id="ContactForm-email"
        name="contact[email]"
        value="{{ form.email }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
        placeholder="{{ 'contact_form.email' | t }}"
      >
    </div>
  {% endif %}

  {% if show_phone %}
    <div class="contact-form__field">
      <label for="ContactForm-phone">{{ 'contact_form.phone' | t }}</label>

      <input
        type="tel"
        id="ContactForm-phone"
        name="contact[phone]"
        value="{{ form.phone }}"
        autocomplete="tel"
        placeholder="{{ 'contact_form.phone' | t }}"
      >
    </div>
  {% endif %}

  {% if show_subject %}
    <div class="contact-form__field">
      <label for="ContactForm-subject">{{ 'contact_form.subject' | t }}</label>

      <input
        type="text"
        id="ContactForm-subject"
        name="contact[subject]"
        value="{{ form.subject }}"
        placeholder="{{ 'contact_form.subject' | t }}"
      >
    </div>
  {% endif %}

  {% if show_message %}
    <div class="contact-form__field">
      <label for="ContactForm-message">{{ 'contact_form.message' | t }}</label>

      <textarea
        rows="6"
        id="ContactForm-message"
        name="contact[body]"
        placeholder="{{ 'contact_form.message' | t }}"
        required
      >{{ form.body }}</textarea>
    </div>
  {% endif %}

  <button type="submit" class="button contact-form__submit">{{ 'contact_form.submit' | t }}</button>
{% endform %}
