{%- comment -%} Position-aware content overlay on a media background. Usage: render 'overlay-content', content:, position:, text_alignment:, class: {%- endcomment -%}

{%- if content != blank -%}
  {%- liquid
    assign position = position | default: 'center-center'
    assign text_alignment = text_alignment | default: 'center'
    assign position_parts = position | split: '-'
    assign vertical_part = position_parts[0]
    assign horizontal_part = position_parts[1]

    case vertical_part
      when 'center'
        assign vertical_class = 'justify-center'
      when 'bottom'
        assign vertical_class = 'justify-end'
      else
        assign vertical_class = ''
    endcase

    case horizontal_part
      when 'center'
        assign horizontal_class = 'items-center'
      when 'right'
        assign horizontal_class = 'items-end'
      else
        assign horizontal_class = 'items-start'
    endcase
  -%}
  <div class="overlay-content absolute-fill flex flex-column {{ vertical_class }} {{ horizontal_class }} text-{{ text_alignment }}{% if class != blank %} {{ class }}{% endif %}">
    <div class="overlay-content__inner flex flex-column gap-1">
      {{ content }}
    </div>
  </div>
{%- endif -%}
