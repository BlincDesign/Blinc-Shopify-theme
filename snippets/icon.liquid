{%- comment -%}
  Usage: {% render 'icon', name: 'account', class: 'account' size: 16 %}
  Accepts: 'account', 'chevron', 'chevron-right', 'chevron-left', 'cart', 'play', 'close', 'eye', 'spinner', 'check'
{%- endcomment -%}

<span
  class="icon {{ class }}"
  data-icon="{{ name }}"
  aria-label="{{ name }}"
  style="--icon-size: {{ size | default: 24 }}px;"
>
  {%- case name -%}
    {%- when 'account' -%}
      <svg
        class="icon icon--account"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="8" r="3.25"></circle>
        <path d="M4.5 19.25c1.4-3.6 4.4-5.5 7.5-5.5s6.1 1.9 7.5 5.5"></path>
      </svg>

    {%- when 'chevron' -%}
      <svg
        class="icon--chevron"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 -960 960 960"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M480-345 240-585l56-56 184 184 184-184 56 56Z"/>
      </svg>

    {%- when 'chevron-right' -%}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
        <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
      </svg>

    {%- when 'chevron-left' -%}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor">
        <path d="M560-240 320-480l240-240 56 56-184 184 184 184-56 56Z"/>
      </svg>

    {%- when 'cart' -%}
      <svg
        class="icon icon--cart"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 6h2l1.5 10.5a1.5 1.5 0 0 0 1.5 1.5h8a1.5 1.5 0 0 0 1.5-1.25L20 9H7"></path>
        <circle cx="10" cy="20.5" r="1.25"></circle>
        <circle cx="17" cy="20.5" r="1.25"></circle>
      </svg>
    {%- when 'play' -%}
      <svg class="icon icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M8 5.5v13l11-6.5z"></path>
      </svg>

    {%- when 'close' -%}
      <svg
        class="icon icon--close"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>

    {%- when 'eye' -%}
      <svg
        class="icon icon--eye"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"></path>
        <circle cx="12" cy="12" r="2.75"></circle>
      </svg>

    {%- when 'spinner' -%}
      <svg
        class="icon icon--spinner"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 2.5a9.5 9.5 0 1 0 9.5 9.5" opacity="0.85"></path>
      </svg>

    {%- when 'check' -%}
      <svg
        class="icon icon--check"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M5 12.5l4.5 4.5L19 7"></path>
      </svg>
  {%- endcase -%}
</span>
