{%- comment -%}
  Renders a responsive, accessible Shopify image with an automatic srcset
  and optional cropping via aspect-ratio.

  Defaults to lazy-loading. For above-the-fold / LCP images (e.g. the first
  image in a hero, or a header logo), the caller must explicitly pass
  `loading: 'eager'` and `fetchpriority: 'high'`.

  Accepts:
  image (object, optional) - The Shopify image object. When blank, renders the built-in `placeholder` SVG instead.
  width (number, optional) - Max display width in px. Drives the fallback `src` size and the default `sizes` value.
  widths (string, optional) - Comma-separated candidate widths for the generated `srcset`.
  sizes (string, optional) - The `sizes` attribute. Defaults to a value based on `width`, or '100vw'.
  aspect_ratio (string, optional) - Forces a CSS aspect-ratio on the image, cropping it via object-fit.
  object_position (string, optional) - CSS object-position value. Defaults to the image's focal point.
  fill (boolean, optional) - Adds the `fit-cover` utility class so the image fills its box. Default: true.
  class (string, optional) - Additional CSS classes for the `<img>`.
  id (string, optional) - ID attribute for the `<img>`.
  alt (string, optional) - Overrides the alt text. Falls back to the image's own alt text.
  loading (string, optional) - 'eager' or 'lazy'. Default: 'lazy'.
  fetchpriority (string, optional) - 'high', 'low', or 'auto'. Default: 'auto'.
  placeholder (string, optional) - Built-in Shopify placeholder SVG name used when `image` is blank. Default: 'image'.

  Usage:
  {% render 'image',
    image: section.settings.image,
    width: 800,
    aspect_ratio: '4/3',
    sizes: '(min-width: 750px) 50vw, 100vw'
  %}

  Above-the-fold hero image:
  {% render 'image',
    image: section.settings.image,
    width: 1600,
    loading: 'eager',
    fetchpriority: 'high'
  %}
{%- endcomment -%}

{%- liquid
  assign display_width = width | default: 1200
  assign widths = widths | default: '375, 550, 750, 1100, 1500, 1600'

  if sizes == blank
    if width
      assign sizes = '(min-width: ' | append: width | append: 'px) ' | append: width | append: 'px, 100vw'
    else
      assign sizes = '100vw'
    endif
  endif

  if fill == null
    assign fill = true
  endif

  assign css_class = class | default: ''
  if fill
    assign css_class = css_class | append: ' fit-cover' | strip
  endif

  assign alt_text = alt | default: image.alt | default: ''

  assign loading = loading | default: 'lazy'
  assign fetchpriority = fetchpriority | default: 'auto'

  assign object_position = object_position | default: image.presentation.focal_point

  capture image_style
    if aspect_ratio != blank
      echo 'aspect-ratio: ' | append: aspect_ratio | append: ';'
    endif
    if object_position != blank
      echo ' object-position: ' | append: object_position | append: ';'
    endif
  endcapture
  assign image_style = image_style | strip
  assign placeholder_class = css_class | append: ' placeholder-svg' | strip
  assign placeholder = placeholder | default: 'image'
-%}

{%- if image -%}
  {{
    image
    | image_url: width: display_width
    | image_tag:
      widths: widths,
      sizes: sizes,
      alt: alt_text,
      loading: loading,
      fetchpriority: fetchpriority,
      class: css_class,
      id: id,
      style: image_style,
      decoding: 'async'
  }}
{%- else -%}
  {{ placeholder | placeholder_svg_tag: placeholder_class }}
{%- endif -%}
