{%- comment -%}
  Renders a quantity stepper (decrease / input / increase). The enclosing
  <quantity-selector> custom element (assets/global.js) wires the buttons and
  clamps the value between `min` and `max`. Used by both the product form
  (assets/product.js keeps `max` in sync with the selected variant's
  inventory) and the cart line items.

  Accepts:
  id (string, required) - Unique id for the input (and its label's `for`).
  name (string, optional) - Form field name. Default: 'quantity'.
  value (number, optional) - Current quantity. Default: 1.
  min (number, optional) - Default: 1.
  max (number, optional) - Omit or 0 for no max.

  Usage:
  {% render 'quantity-selector', id: 'Quantity-' | append: section.id, max: quantity_max %}
  {% render 'quantity-selector', id: 'Quantity-' | append: item.key, name: 'updates[' | append: item.key | append: ']', value: item.quantity %}
{%- endcomment -%}

{%- liquid
  assign quantity_name = name | default: 'quantity'
  assign quantity_value = value | default: 1
  assign quantity_min = min | default: 1
-%}

<quantity-selector class="quantity-selector">
  <button type="button" class="quantity-selector__button" data-decrease aria-label="{{ 'products.product.decrease_quantity' | t }}">&minus;</button>
  <label class="visually-hidden" for="{{ id }}">{{ 'products.product.quantity' | t }}</label>
  <input
    type="number"
    id="{{ id }}"
    class="quantity-selector__input"
    name="{{ quantity_name }}"
    value="{{ quantity_value }}"
    min="{{ quantity_min }}"
    {%- if max > 0 %} max="{{ max }}"{% endif %}
    inputmode="numeric"
    data-quantity-input
  >
  <button type="button" class="quantity-selector__button" data-increase aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
</quantity-selector>
