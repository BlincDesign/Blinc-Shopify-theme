{%- if cart.item_count == 0 -%}
  <div class="cart-drawer__empty flex flex-column items-center text-center">
    {%- render 'icon', name: 'cart', class: 'cart-drawer__empty-icon', size: 32 -%}
    <p class="cart-drawer__empty-text text-body">{{ 'cart.empty' | t }}</p>
    {%- render 'button',
      label: continue_shopping_label,
      url: routes.all_products_collection_url,
      button_style: 'primary'
    -%}
  </div>
{%- else -%}
  <div class="cart-drawer__items flex flex-column">
    {%- for item in cart.items -%}
      {% render 'cart-item', item: item %}
    {%- endfor -%}
  </div>

  <div class="cart-drawer__footer flex flex-column">
    {%- if cart.total_discount > 0 -%}
      <p class="cart-drawer__discount text-body text-body--small">
        {{ 'cart.discount' | t }}: -{{ cart.total_discount | money }}
      </p>
    {%- endif -%}

    <p class="cart-drawer__subtotal heading heading--small">
      {{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}
    </p>

    {%- unless has_checkout_info_block -%}
      <p class="cart-drawer__note text-body text-body--small">{{ 'cart.taxes_and_shipping' | t }}</p>
    {%- endunless -%}

    <div class="cart-drawer__footer-actions flex flex-column">
      {%- render 'button',
        label: continue_shopping_label,
        url: routes.all_products_collection_url,
        button_style: 'secondary'
      -%}

      {%- form 'cart', cart, class: 'cart-drawer__checkout-form' -%}
        {%- render 'button',
          label: checkout_label,
          type: 'submit',
          name: 'checkout',
          button_style: 'primary',
          attributes: 'data-checkout-button'
        -%}
        {{- content_for_additional_checkout_buttons -}}
      {%- endform -%}
    </div>
  </div>
{%- endif -%}
