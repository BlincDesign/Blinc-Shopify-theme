{%- comment -%}
  Accepts:
  product (object, required)
  picker_style (string, optional) - 'pills' or 'dropdown'. Default: 'pills'.

  Usage:
  {% render 'variant-picker', product: product, picker_style: section.settings.variant_picker_style %}
{%- endcomment -%}

{%- liquid
  assign picker_style = picker_style | default: 'pills'
-%}

{% unless product.has_only_default_variant %}
  <variant-picker class="variant-picker flex flex-column" 
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
  >
    {%- for option in product.options_with_values -%}
      <div class="variant-picker__option" data-option-position="{{ option.position }}">
          <span class="variant-picker__label">
            {{ option.name }}: <span class="variant-picker__value">{{ option.selected_value }}</span>
          </span>
          <div class="variant-picker__pills flex flex-wrap">
            {%- for value in option.values -%}
              {%- assign input_id = 'Option-'
                | append: product.id
                | append: '-'
                | append: option.position
                | append: '-'
                | append: forloop.index
              -%}
              <input
                type="radio"
                id="{{ input_id }}"
                class="hidden variant-picker__radio"
                name="options[{{ option.name | escape }}]"
                value="{{ value | escape }}"
                data-option-input
                {% if value == option.selected_value %}
                  checked
                {% endif %}
              >
              <label class="variant-picker__pill" for="{{ input_id }}">{{ value }}</label>
            {%- endfor -%}
          </div>
      </div>
    {%- endfor -%}
  </variant-picker>
{% endunless %}
