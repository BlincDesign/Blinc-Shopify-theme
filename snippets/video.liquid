{%- comment -%} Renders a Shopify-hosted or external video. Usage: render 'video', video:, aspect_ratio:, autoplay:, loop:, muted:, controls:, class: {%- endcomment -%}

{%- liquid
  assign autoplay = autoplay | default: false
  if muted == null
    assign muted = autoplay
  endif
  if controls == null
    assign controls = true
    if autoplay
      assign controls = false
    endif
  endif
  assign video_class = class | default: ''
-%}

{%- capture video_markup -%}
  {%- case video.media_type -%}
    {%- when 'video' -%}
      {{
        video
        | video_tag:
          image_size: '1100x',
          autoplay: autoplay,
          loop: loop,
          muted: muted,
          controls: controls,
          class: video_class
      }}
    {%- when 'external_video' -%}
      {{
        video
        | external_video_tag:
          class: video_class,
          autoplay: autoplay,
          loop: loop
      }}
  {%- endcase -%}
{%- endcapture -%}

{%- if aspect_ratio != blank -%}
  <div class="video-wrapper" style="aspect-ratio: {{ aspect_ratio }};">
    {{ video_markup }}
  </div>
{%- else -%}
  {{ video_markup }}
{%- endif -%}
