{%- comment -%} 
  Accepts:
  product (object, required)
  variant (object, optional) - Defaults to product.selected_or_first_available_variant.
  block (object, optional) - A section block; when passed, its shopify_attributes are applied for theme editor support.

  Usage:
  {% render 'product-price', product: product %}
{%- endcomment -%}

{%- liquid
  assign variant = variant | default: product.selected_or_first_available_variant
-%}

<div class="product__price flex items-center heading heading--small" data-product-price {{ block.shopify_attributes }}>
  {%- if variant.compare_at_price > variant.price -%}
    <span class="product__price-compare">{{ variant.compare_at_price | money }}</span>
    <span class="product__price-sale">{{ variant.price | money }}</span>
  {%- else -%}
    <span>{{ variant.price | money }}</span>
  {%- endif -%}
</div>
