{% comment %}
  Renders a minimal placeholder product card.

  Accepts:
  media_placeholder (string, optional) - Built-in placeholder SVG name.
{% endcomment %}

{%- liquid
  assign media_placeholder = media_placeholder | default: 'product-1'
  assign aspect_ratio = settings.grid_image_aspect_ratio | default: 1
  assign aspect_ratio_css = '1 / ' | append: aspect_ratio

  case settings.title_size
    when 'small'
      assign title_class = 'text-body text-body--small'
    when 'large'
      assign title_class = 'heading heading--small'
    else
      assign title_class = 'text-body'
  endcase
-%}

<div class="product-card flex flex-column">

  <div class="product-card__media" style="aspect-ratio: {{ aspect_ratio_css }};">

    {%- render 'image',
      aspect_ratio: aspect_ratio_css,
      placeholder: media_placeholder
    -%}

    {%- if settings.show_soldout_badge or settings.show_sale_badge or settings.show_new_badge or settings.show_category_badge -%}
      <div class="product-card__badges flex flex-column items-start">
        <span class="product-card__badge product-card__badge--placeholder"></span>
      </div>
    {%- endif -%}


    {%- if settings.grid_button_action == 'quick_add' -%}
      <span
        class="product-card__atc-icon product-card__atc-icon--placeholder items-center justify-center"
        aria-hidden="true"
      >
        {%- render 'icon', name: 'cart' -%}
      </span>

    {%- elsif settings.grid_button_action == 'add_to_cart' -%}
      <div class="product-card__atc-hover">
        {%- render 'button',
          label: 'Add to cart',
          type: 'button',
          button_style: 'primary',
          class: 'product-card__atc-button',
          disabled: true
        -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info flex flex-column">

    {%- if settings.show_vendor -%}
      <p class="product-card__vendor text-body text-body--small">
        Vendor
      </p>
    {%- endif -%}

    <p class="product-card__title {{ title_class }}">
      Product title
    </p>

    {%- if settings.show_price -%}
      <div class="product-card__price flex items-center {{ title_class }}">
        {%- if settings.show_compare_at_price -%}
          <span class="product-card__price-compare">$00.00</span>
          <span class="product-card__price-sale">$00.00</span>
        {%- else -%}
          <span>$00.00</span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

</div>
