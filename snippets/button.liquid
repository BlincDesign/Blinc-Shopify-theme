{% comment %}
  Accepts:
  label (string) - Button text.
  url (string, optional) - Link url. Renders an `<a>`. Takes priority over `type`.
  type (string, optional) - 'submit', 'button', or 'reset'. Renders a native `<button>` when `url` is blank.
  button_style (string, optional) - 'primary' (default), 'secondary', or 'link'. Named `button_style` (not `style`) to avoid colliding with Liquid's own `{% style %}` tag.
  new_tab (boolean, optional) - Opens a link in a new tab (links only).
  disabled (boolean, optional) - Disables a `<button>`, or renders a link as an inert disabled state.
  id (string, optional) - Element id.
  name (string, optional) - Form field name (buttons only, e.g. name: 'add').
  class (string, optional) - Additional classes to append.
  attributes (string, optional) - Raw additional HTML attributes (e.g. data-* hooks for JS), inserted as-is.

  Usage:
  {% render 'button', label: 'Submit', type: 'submit', name: 'add' %}
  {% render 'button', label: 'Shop now', url: '/collections/all', button_style: 'secondary' %}
{% endcomment %}

{%- liquid
  assign button_style = button_style | default: 'primary'
  assign button_class = 'button items-center justify-center'

  unless button_style == 'primary'
    assign button_class = button_class | append: ' button--' | append: button_style
  endunless

  if class != blank
    assign button_class = button_class | append: ' ' | append: class
  endif
-%}

{%- if url != blank -%}
  {%- if disabled -%}
    <span class="{{ button_class }} button--disabled" role="link" aria-disabled="true">{{ label | escape }}</span>
  {%- else -%}
    <a
      href="{{ url }}"
      class="{{ button_class }}"
      {%- if id != blank %} id="{{ id }}"{% endif -%}
      {%- if new_tab %} target="_blank" rel="noopener"{% endif -%}
      {%- if attributes != blank %} {{ attributes }}{% endif -%}
    >
      {{ label | escape }}
    </a>
  {%- endif -%}
{%- elsif type != blank -%}
  <button
    type="{{ type }}"
    class="{{ button_class }}{% if disabled %} button--disabled{% endif %}"
    {%- if id != blank %} id="{{ id }}"{% endif -%}
    {%- if name != blank %} name="{{ name }}"{% endif -%}
    {%- if disabled %} disabled{% endif -%}
    {%- if attributes != blank %} {{ attributes }}{% endif -%}
  >
    {{ label | escape }}
  </button>
{%- else -%}
  <span class="{{ button_class }} button--disabled" role="link" aria-disabled="true">{{ label | escape }}</span>
{%- endif -%}
