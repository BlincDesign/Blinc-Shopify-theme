{%- comment -%}
  Fetched via `{{ product.url }}?section_id=quick-add` by assets/quick-add.js
  and injected into the shared <quick-modal>. Intentionally thin - all the
  real markup lives in snippets/quick-product-form.liquid so Quick Add and
  Quick View never duplicate logic.
{%- endcomment -%}

{%- if product -%}
  {%- render 'quick-product-form', product: product, show_gallery: false -%}
{%- endif -%}

{% schema %}
{
  "name": "Quick add",
  "settings": []
}
{% endschema %}
