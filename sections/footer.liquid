{%- liquid
  assign width_class = 'container-standard'
  if section.settings.enable_full_width
    assign width_class = 'footer__wrapper--full-width'
  endif
-%}

{% style %}
  .footer__logo {
    width: var(--logo-width);
    margin-inline-end: 2rem;
  }
{% endstyle %}

<div id="Footer-{{ section.id }}" class="footer color-{{ section.settings.color_scheme }} ">
  <div class="flex flex-column gap-1 {{ width_class }}">
    <div class="footer__wrapper flex flex-wrap items-start">
      {% for block in section.blocks -%}
        {% liquid
          assign menu = block.settings.menu
          assign logo = block.settings.logo_image
          assign logo_size = block.settings.logo_size
        %}
        <div class="footer__blocks footer__blocks-{{ block.type }} {% unless block.type == 'large-image' %} flex-grow" {% endunless %}>
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'logo' %}
              <div style="--logo-width: {{ logo_size }}px" class="footer__logo" {{ block.shopify_attributes }}>
                {% render 'image', image: logo, alt: logo.alt %}
              </div>

              {% if block.settings.logo_heading != blank or block.settings.logo_description != blank %}
                <div class="multicolumn__column-content gap-1 flex flex-column">
                  {% if block.settings.logo_heading != blank %}
                    <p class="multicolumn__column-heading">
                      {{ block.settings.logo_heading }}
                    </p>
                  {% endif %}

                  {% if block.settings.logo_description != blank %}
                    <div class="multicolumn__column-description">
                      {{ block.settings.logo_description }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}

            {% when 'menu' %}
              {% if menu.links.size > 0 %}
                <div class="flex flex-column gap-half" {{ block.shopify_attributes }}>
                  <h3 class="footer__menu-heading heading heading--{{ block.settings.heading_size }}">
                    {{ block.settings.menu_heading }}
                  </h3>
                  <nav class="footer__nav" aria-label="Footer">
                    <ul class="footer__nav-list flex flex-column gap-half">
                      {%- for link in menu.links -%}
                        <li>
                          <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                </div>
              {% endif %}
            {% when 'newsletter' %}

            {% when 'contact' %}

            {% when 'newsletter' %}

            {% when 'large-image' %}
              <div {{ block.shopify_attributes }}>
                {% render 'image', image: block.settings.large_image, alt: block.settings.large_image %}
              </div>
          {% endcase %}
        </div>
      {%- endfor %}
    </div>
    <p class="footer__copyright">
      <b> {{ shop.name }} &copy; {{ 'now' | date: '%Y' }} </b>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "shopify-section--footer",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_size",
          "label": "Size",
          "min": 100,
          "max": 500,
          "default": 100,
          "step": 10,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "logo_heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "richtext",
          "id": "logo_description",
          "label": "Description",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "menu_heading",
          "label": "Heading",
          "default": "Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "small"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": []
    },
    {
      "type": "contact",
      "name": "Contact us",
      "limit": 1,
      "settings": []
    },
    {
      "type": "large-image",
      "name": "Large image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "large_image",
          "label": "Logo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "Enable full-width footer",
      "default": false
    }
  ]
}
{% endschema %}
