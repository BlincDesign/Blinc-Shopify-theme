{%- liquid
  assign width_class = 'container-standard'
  if section.settings.enable_full_width
    assign width_class = 'footer__wrapper--full-width'
  endif

  assign has_social_icons = true
  if settings.social_facebook_link == blank or settings.social_instagram_link == blank or settings.social_youtube_link == blank or settings.social_tiktok_link == blank or settings.social_twitter_link == blank or settings.social_pinterest_link == blank or settings.social_snapchat_link == blank or settings.social_tumblr_link == blank or settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}

{% style %}
{% endstyle %}

<div id="Footer-{{ section.id }}" class="footer color-{{ section.settings.color_scheme }} ">
  <div class="flex flex-column gap-1 {{ width_class }}">
    <div class="footer__wrapper flex flex-wrap items-start mobile-flex-column">
      {% for block in section.blocks -%}
        {% liquid
          assign menu = block.settings.menu
          assign heading_size = block.settings.heading_size
          assign menu_heading = block.settings.menu_heading
          assign logo = block.settings.logo_image
          assign logo_size = block.settings.logo_size
          assign logo_heading = block.settings.logo_heading
          assign logo_description = block.settings.logo_description

          assign large_logo = block.settings.large_logo
        %}
        <div class="footer__blocks footer__blocks--{{ block.type }} {% unless block.type == 'large-logo' %} flex-grow {% endunless %}">
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'logo' %}
              <a
                href="{{ routes.root_url }}"
                class="footer__logo"
                style="--logo-width: {{ logo_size }}px"
                aria-label="{{ shop.name | escape }}"
                {{ block.shopify_attributes }}
              >
                {% render 'image', image: logo, alt: shop.name %}
              </a>

              {% if logo_heading != blank or logo_description != blank %}
                <div class="footer__logo-content gap-1 flex flex-column">
                  {% if logo_heading != blank %}
                    <p class="footer__logo-content-heading">
                      {{ logo_heading }}
                    </p>
                  {% endif %}

                  {% if logo_description != blank %}
                    <div class="footer__logo-content-description">
                      {{ logo_description }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}

            {% when 'menu' %}
              {% if menu.links.size > 0 %}
                <div class="flex flex-column gap-half" {{ block.shopify_attributes }}>
                  <nav class="flex flex-column footer__nav gap-1" aria-label="{{ menu_heading | escape }}">
                    <h3 class="footer__menu-heading heading heading--{{ heading_size }}">
                      {{ menu_heading }}
                    </h3>
                    <ul class="footer__nav-list flex flex-column gap-half">
                      {%- for link in menu.links -%}
                        <li>
                          <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                </div>
              {% endif %}
            {% when 'newsletter' %}
              {% render 'newsletter', show_name: true, show_email: true, show_consent: false %}

            {% when 'large-logo' %}
              <div {{ block.shopify_attributes }}>
                <a href="{{ routes.root_url }}">
                  {% render 'image', image: large_logo, alt: large_logo.alt %}
                </a>
              </div>
          {% endcase %}
        </div>
      {%- endfor %}
    </div>

    {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
      <div class="footer__follow-on-shop">
        {{ shop | login_button: action: 'follow' }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_social and has_social_icons -%}
      {%- render 'social-icons', class: 'footer__list-social' -%}
    {%- endif -%}
    <p class="footer__copyright">
      <b> {{ shop.name }} &copy; {{ 'now' | date: '%Y' }} </b>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "shopify-section--footer",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_size",
          "label": "Size",
          "min": 100,
          "max": 500,
          "default": 100,
          "step": 10,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "logo_heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "richtext",
          "id": "logo_description",
          "label": "Description",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "menu_heading",
          "label": "Heading",
          "default": "Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "small"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": []
    },
    {
      "type": "large-logo",
      "name": "Large logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "large_logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "Enable full-width footer",
      "default": false
    },
    {
      "type": "header",
      "content": "Utilities"
    },
    {
      "type": "checkbox",
      "id": "enable_shop",
      "label": "Follow on Shop",
      "info": "Shop Pay must be enabled. [Learn more](https://help.shopify.com/manual/online-store/themes/customizing-themes/follow-on-shop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_social_media_icons",
      "label": "Social media icons",
      "default": false
    }
  ]
}
{% endschema %}
