<div id="Footer-{{ section.id }}" class="footer color-{{ section.settings.color_scheme }} ">
  <div class="{{ section.settings.container_width }}">
    <div class="footer__wrapper flex flex-wrap items-center">
      {% for block in section.blocks -%}
        {% liquid
          assign menu = block.settings.menu
          assign logo = block.settings.logo
          assign logo_size = block.settings.logo_size
        %}
        <div class="footer__blocks footer__blocks-{{ block.type }}">
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'logo' %}
              <div {{ block.shopify_attributes }}>
                {% render 'image', image: logo, alt: logo.alt, display_width: logo_size %}
              </div>
            {% when 'menu' %}
              {% if menu.links.size > 0 %}
                <h3 class="footer__menu-heading heading heading--{{ block.settings.heading_size }}">
                  {{ block.settings.menu_heading }}
                </h3>
                <nav class="footer__nav" aria-label="Footer" {{ block.shopify_attributes }}>
                  <ul class="footer__nav-list flex flex-column gap-1">
                    {%- for link in menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
              {% endif %}
            {% when 'newsletter' %}

            {% when 'contact' %}

            {% when 'newsletter' %}

            {% when 'large-image' %}

          {% endcase %}
        </div>
      {% endfor %}
    </div>
    <p class="footer__copyright">{{ 'now' | date: '%Y' }} &copy; {{ shop.name }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "shopify-section--footer",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_size",
          "label": "Size",
          "min": 100,
          "max": 500,
          "default": 100,
          "step": 10,
          "unit": "px"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "menu_heading",
          "label": "Heading",
          "default": "Title"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "small"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": []
    },
    {
      "type": "contact",
      "name": "Contact us",
      "limit": 1,
      "settings": []
    },
    {
      "type": "large-image",
      "name": "Large image",
      "limit": 1,
      "settings": []
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        {
          "value": "full-width",
          "label": "Full Width"
        },
        {
          "value": "container-padded",
          "label": "Full Width (Padded)"
        },
        {
          "value": "container-standard",
          "label": "Standard"
        },
        {
          "value": "container-narrow",
          "label": "Narrow"
        }
      ]
    }
  ]
}
{% endschema %}
