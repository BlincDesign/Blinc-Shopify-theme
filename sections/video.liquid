{%- liquid
  case section.settings.aspect_ratio
    when 'square'
      assign aspect_ratio = '1/1'
    when 'portrait'
      assign aspect_ratio = '9/16'
    when 'landscape'
      assign aspect_ratio = '4/3'
    when 'landscape_wide'
      assign aspect_ratio = '16/9'
    else
      assign aspect_ratio = '16/9'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .video-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .video-section {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div class="video-section color-{{ section.settings.color_scheme }}">
  <div class="video-section__wrapper {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="video-section__header section__header text-center">
        <h2 class="video-section__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.settings.video != blank -%}
      {%- render 'video',
        video: section.settings.video,
        aspect_ratio: aspect_ratio,
        autoplay: section.settings.autoplay,
        loop: section.settings.autoplay
      -%}
    {%- else -%}
      <div class="video-wrapper" style="aspect-ratio: {{ aspect_ratio }};">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "shopify-section--video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Add a video from your files, or a URL from YouTube or Vimeo."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "landscape_wide", "label": "16:9" },
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "9:16" },
        { "value": "landscape", "label": "4:3" }
      ],
      "default": "landscape_wide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Autoplaying video is muted, looped, and hides controls. Disabled automatically for visitors who prefer reduced motion.",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
