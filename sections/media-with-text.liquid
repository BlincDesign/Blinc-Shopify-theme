{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign aspect_ratio = '1 / 1'
    when 'portrait'
      assign aspect_ratio = '3 / 4'
    when 'landscape'
      assign aspect_ratio = '4 / 3'
    else
      assign aspect_ratio = section.settings.image.aspect_ratio | default: '16/9'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .media-with-text {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .media-with-text {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }

  .media-with-text__content {
      padding: var(--layout-padding);
  }
{%- endstyle -%}

<div class="media-with-text color-{{ section.settings.color_scheme }}">
  <div class="media-with-text__wrapper {{ section.settings.container_width }} flex mobile-flex-column {% if section.settings.media_position == "right" %} flex-reverse{% endif %}">
    <div class="media-with-text__media flex-grow">
      {%- if section.settings.video != blank -%}
        {%- render 'video', video: section.settings.video, aspect_ratio: aspect_ratio -%}
      {%- else -%}
        {%- render 'image',
          image: section.settings.image,
          aspect_ratio: aspect_ratio,
          width: 800,
          sizes: '(min-width: 750px) 50vw, 100vw'
        -%}
      {%- endif -%}
    </div>

    <div class="media-with-text__content flex flex-column flex-grow text-{{ section.settings.text_alignment }} justify-{{ section.settings.vertical_position }} rte-column">
      {%- if section.blocks.size > 0 -%}
        {%- liquid
          assign should_loop = false
          if section.blocks.size > 2
            assign should_loop = true
          endif
        -%}
        <div
          class="media-with-text__content-inner{% if section.blocks.size > 1 %} overflow-hidden{% endif %}"
          {% if section.blocks.size > 1 %}
            data-slider
            data-slider-config='
              {
                "loop": {{ should_loop }},
                "slidesPerView": 1,
                "autoHeight": true
              }
            '
          {% endif %}
        >
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="media-with-text__content-slide swiper-slide" data-slide {{ block.shopify_attributes }}>
                {%- if block.settings.preheading != blank -%}
                  <p class="media-with-text__preheading text-subheading">{{ block.settings.preheading }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="media-with-text__heading heading heading--large">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="media-with-text__text text-body">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if section.blocks.size > 1 -%}
            {%- render 'swiper-controls', type: 'bullets', enable_arrows: true -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Media with text",
  "class": "shopify-section--media-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Overrides the image when set."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Media ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        {
          "value": "full-width",
          "label": "Full Width"
        },
        {
          "value": "container-padded",
          "label": "Full Width (Padded)"
        },
        {
          "value": "container-standard",
          "label": "Standard"
        },
        {
          "value": "container-narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "text",
          "id": "preheading",
          "label": "Preheading",
          "default": "Our story"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Talk about your brand"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Media with text",
      "blocks": [{ "type": "content" }]
    }
  ]
}
{% endschema %}
