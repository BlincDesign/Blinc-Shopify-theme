{%- comment -%}
  Fetched via `{{ product.url }}?section_id=quick-view` by <quick-modal>
  (assets/theme.js) and injected into the shared modal. Intentionally thin - all the
  real markup lives in snippets/quick-product-form.liquid so Quick Add and
  Quick View never duplicate logic.
{%- endcomment -%}

{%- if product -%}
  {%- render 'quick-product-form', product: product, show_gallery: true -%}
{%- endif -%}

{% schema %}
{
  "name": "Quick view",
  "settings": []
}
{% endschema %}
