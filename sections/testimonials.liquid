{%- style -%}
  #multicolumn-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #multicolumn-{{ section.id }} .multicolumn__column-content {
    padding: 1rem;
  }

  @media screen and (max-width: 749px) {
    #multicolumn-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign is_above_fold_section = false

  if section.index <= 2
    assign is_above_fold_section = true
  endif

  assign total_slides = section.blocks.size

  if section.settings.carousel
    assign slides_desktop = section.settings.slides_per_row_dt | default: 4 | plus: 0
    assign slides_mobile = section.settings.slides_per_row_mb | default: 2 | plus: 0

    assign max_slides_per_view = slides_desktop
    if slides_mobile > max_slides_per_view
      assign max_slides_per_view = slides_mobile
    endif

    assign min_required_for_loop = max_slides_per_view | times: 2

    assign should_loop = false
    if total_slides >= min_required_for_loop
      assign should_loop = true
    endif

    assign desktop_fraction = 100 | divided_by: slides_desktop | round: 2
    assign mobile_fraction = 100 | divided_by: slides_mobile | round: 2

    assign column_sizes = '(min-width: 750px) ' | append: desktop_fraction | append: 'vw, ' | append: mobile_fraction | append: 'vw'
  else
    assign desktop_columns = section.settings.columns | default: 4 | plus: 0
    assign mobile_columns = section.settings.mobile_columns | default: 2 | plus: 0

    assign desktop_fraction = 100 | divided_by: desktop_columns | round: 2
    assign mobile_fraction = 100 | divided_by: mobile_columns | round: 2

    assign column_sizes = '(min-width: 750px) ' | append: desktop_fraction | append: 'vw, ' | append: mobile_fraction | append: 'vw'
  endif
-%}

<div
  id="multicolumn-{{ section.id }}"
  class="multicolumn color-{{ section.settings.color_scheme }}"
>
  <div class="multicolumn__wrapper section__wrapper relative overflow-hidden {{ section.settings.container_width }}">

    {% if section.settings.heading != blank %}
      <div class="multicolumn__header text-{{ section.settings.heading_alignment }}">
        <h2 class="multicolumn__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div
      class="multicolumn__blocks overflow-hidden{% unless section.settings.carousel %} grid grid-columns grid-columns-mobile{% endunless %}"
      {% unless section.settings.carousel %}
        style="
          --grid-columns: {{ section.settings.columns }};
          --grid-columns-mobile: {{ section.settings.mobile_columns }};
        "
      {% endunless %}

      {% if section.settings.carousel %}
        data-slider
        data-slider-config='
          {
            "loop": {{ should_loop }},
            "slidesPerView": {{ slides_mobile | minus: 0.5 }},
            "spaceBetween": "var(--layout-gap)",
            "breakpoints": {
              "750": {
                "slidesPerView": {{ slides_desktop | minus: 0.5 }},
                "spaceBetween": "var(--layout-gap)"
              }
            }
          }
        '
      {% endif %}
    >

      {% if section.settings.carousel %}
        <div class="swiper-wrapper">
      {% endif %}

      {% for block in section.blocks %}

        {%- liquid
          assign is_priority = false

          if is_above_fold_section and forloop.first
            assign is_priority = true
          endif

          assign img_loading = 'lazy'
          assign img_fetchpriority = 'auto'

          if is_priority
            assign img_loading = 'eager'
            assign img_fetchpriority = 'high'
          endif
        -%}

        <article
          id="block-{{ block.id }}"
          class="
            multicolumn__column
            multicolumn__column--{{ block.type }}
            flex
            flex-column
            color-{{ section.settings.column_color_scheme }}
            {% if section.settings.carousel %}swiper-slide{% endif %}
          "
          {% if section.settings.carousel %}
            data-slide
          {% endif %}
          {{ block.shopify_attributes }}
        >

          {% if block.settings.column_video != blank or block.settings.column_image != blank %}
            <div class="multicolumn__column-media">

              {% if block.settings.column_video != blank %}

                {{
                  block.settings.column_video
                  | video_tag:
                    autoplay: true,
                    muted: true,
                    controls: false,
                    loop: true,
                    playsinline: true,
                    class: 'multicolumn__column-video'
                }}

              {% elsif block.settings.column_image != blank %}

                {% render 'image',
                  image: block.settings.column_image,
                  class: 'multicolumn__column-image',
                  sizes: column_sizes,
                  loading: img_loading,
                  fetchpriority: img_fetchpriority
                %}

              {% endif %}

            </div>
          {% endif %}

          {% if block.settings.column_heading != blank or block.settings.column_info != blank %}
            <div class="multicolumn__column-content gap-1 flex flex-column">

              {% if block.settings.column_heading != blank %}
                <h3 class="multicolumn__column-heading">
                  {{ block.settings.column_heading }}
                </h3>
              {% endif %}

              {% if block.settings.column_info != blank %}
                <div class="multicolumn__column-info">
                  {{ block.settings.column_info }}
                </div>
              {% endif %}

            </div>
          {% endif %}

        </article>

      {% endfor %}

      {% if section.settings.carousel %}
        </div>

        {% render 'swiper-controls',
          type: section.settings.pagination_type,
          enable_arrows: section.settings.enable_arrows
        %}
      {% endif %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "multicolumns",
  "tag": "section",
  "class": "multicolumns-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },

  "blocks": [
    {
      "type": "column",
      "name": "multicolumn",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "video",
          "id": "column_video",
          "label": "Video",
          "info": "If video is added, the image will not be displayed."
        },
        {
          "type": "image_picker",
          "id": "column_image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "column_heading",
          "label": "Heading",
          "default": "Include a favorite customer quote or feedback here."
        },
        {
          "type": "richtext",
          "id": "column_info",
          "label": "Info",
          "default": "<p><strong>Customer name</strong></p><p><em>More info about them could go here.</em></p><p>customerlink.com</p>"
        }
      ]
    }
  ],

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "multicolumns"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "large",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xl",
          "label": "XL"
        },
        {
          "value": "xxl",
          "label": "XXL"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },

    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "color_scheme",
      "id": "column_color_scheme",
      "label": "Column color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Carousel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination type",
      "default": "scrollbar",
      "visible_if": "{{ section.settings.carousel }}",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "scrollbar",
          "label": "Scrollbar"
        },
        {
          "value": "bullets",
          "label": "Bullets"
        },
        {
          "value": "dynamic-bullets",
          "label": "Dynamic bullets"
        },
        {
          "value": "progressbar",
          "label": "Progressbar"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.carousel == false }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns mobile",
      "default": "2",
      "visible_if": "{{ section.settings.carousel == false }}",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "slides_per_row_dt",
      "label": "Slides per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "select",
      "id": "slides_per_row_mb",
      "label": "Slides per row (mobile)",
      "default": "2",
      "visible_if": "{{ section.settings.carousel }}",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ]
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "container-standard",
      "options": [
        {
          "value": "full-width",
          "label": "Full Width"
        },
        {
          "value": "container-padded",
          "label": "Full Width (Padded)"
        },
        {
          "value": "container-standard",
          "label": "Standard"
        },
        {
          "value": "container-narrow",
          "label": "Narrow"
        }
      ]
    },

    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },

    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],

  "presets": [
    {
      "name": "multicolumns",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}