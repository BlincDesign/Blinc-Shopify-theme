{%- liquid
  assign quote_preset = section.settings.quote_preset
  assign info_preset = section.settings.info_preset

  case section.settings.image_ratio
    when 'square'
      assign aspect_ratio = '1 / 1'
    when 'portrait'
      assign aspect_ratio = '3 / 4'
    when 'landscape'
      assign aspect_ratio = '4 / 3'
    else
      assign aspect_ratio = 'auto'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div class="testimonials color-{{ section.settings.color_scheme }} {{ section.settings.container_width }}">
  <div class="testimonials__wrapper">

    {% for block in section.blocks %}
      <div
        class="testimonial-block"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}
          <div class="testimonial__image">
            {%- render 'image',
              image: block.settings.image,
              aspect_ratio: aspect_ratio,
              width: 200,
              sizes: '(min-width: 750px) 50vw, 100vw'
            -%}
          </div>
        {% endif %}

        {% if block.settings.quote != blank %}
          <div class="testimonial__quote {{ quote_preset }}">
            {{ block.settings.quote }}
          </div>
        {% endif %}

        {% if block.settings.info != blank %}
          <div class="testimonial__info {{ info_preset }}">
            {{ block.settings.info }}
          </div>
        {% endif %}

      </div>
    {% endfor %}

  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "class": "shopify-section--testimonials",

  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        {
          "value": "full-width",
          "label": "Full Width"
        },
        {
          "value": "container-padded",
          "label": "Full Width (Padded)"
        },
        {
          "value": "container-standard",
          "label": "Standard"
        },
        {
          "value": "container-narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "quote_preset",
      "label": "Quote typography",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "Heading 1"
        },
        {
          "value": "h2",
          "label": "Heading 2"
        },
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "body",
          "label": "Body"
        }
      ]
    },
    {
      "type": "select",
      "id": "info_preset",
      "label": "Info typography",
      "default": "body",
      "options": [
        {
          "value": "h3",
          "label": "Heading 3"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "caption",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],

  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "500 x 500px recommended"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Include a favorite customer quote or feedback here.</p>"
        },
        {
          "type": "richtext",
          "id": "info",
          "label": "Info",
          "default": "<p><strong>Customer name</strong></p><p><em>More info about them could go here.</em></p><p>customerlink.com</p>"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}