{%- style -%}
  #Testimonials-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign total_blocks = section.blocks.size
  assign max_slides_per_view = section.settings.slides_per_row_dt
  if section.settings.slides_per_row_mb > max_slides_per_view
    assign max_slides_per_view = section.settings.slides_per_row_mb
  endif
  assign min_required_for_loop = max_slides_per_view | times: 2
  assign should_loop = false
  if total_blocks >= min_required_for_loop
    assign should_loop = true
  endif
-%}

<div id="Testimonials-{{ section.id }}" class="testimonials color-{{ section.settings.color_scheme }}">
  <div class="testimonials__wrapper section__wrapper relative overflow-hidden {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="testimonials__header section__header text-center">
        <h2 class="testimonials__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="testimonials__blocks overflow-hidden {% unless section.settings.carousel %} grid grid-columns grid-columns-mobile {% endunless %}"
        {% unless section.settings.carousel %}
          style="
            --grid-columns: {{ section.settings.columns }};
            --grid-columns-mobile: {{ section.settings.mobile_columns | plus: 0 }};
          "
        {% endunless %}
        {% if section.settings.carousel %}
          data-slider
          data-slider-config='
            {
              "loop": {{ should_loop }},
              "slidesPerView": {{ section.settings.slides_per_row_mb | minus: 0.5 }},
              "spaceBetween": "var(--layout-gap)",
              "breakpoints": {
                "750": {
                  "slidesPerView": {{ section.settings.slides_per_row_dt | minus: 0.5 }},
                  "spaceBetween": "var(--layout-gap)"
                }
              }
            }
          '
        {% endif %}
      >
        {%- if section.settings.carousel -%}
          <div class="swiper-wrapper">
        {%- endif -%}

        {%- for block in section.blocks -%}
          <article
            id="block-{{ block.id }}"
            class="testimonial-card flex flex-column color-{{ section.settings.card_color_scheme }}{% if section.settings.carousel %} swiper-slide{% endif %}"
            {% if section.settings.carousel %}
              data-slide
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.rating > 0 -%}
              <div class="testimonial-card__rating flex" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- liquid
                    assign star_class = 'testimonial-card__star'
                    if i > block.settings.rating
                      assign star_class = star_class | append: ' testimonial-card__star--empty'
                    endif
                  -%}
                  {%- render 'icon', name: 'star', size: 16, class: star_class -%}
                {%- endfor -%}
              </div>
              <span class="visually-hidden">Rated {{ block.settings.rating }} out of 5 stars</span>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <blockquote class="testimonial-card__quote text-body">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            {%- if block.settings.author != blank or block.settings.author_title != blank or block.settings.avatar != blank -%}
              <footer class="testimonial-card__footer flex items-center gap-1">
                {%- if block.settings.avatar != blank -%}
                  {%- render 'image',
                    image: block.settings.avatar,
                    width: 96,
                    aspect_ratio: '1/1',
                    sizes: '48px',
                    class: 'testimonial-card__avatar',
                    loading: 'lazy'
                  -%}
                {%- endif -%}

                <div class="testimonial-card__attribution flex flex-column">
                  {%- if block.settings.author != blank -%}
                    <cite class="testimonial-card__author text-body--small">{{ block.settings.author }}</cite>
                  {%- endif -%}
                  {%- if block.settings.author_title != blank -%}
                    <span class="testimonial-card__author-title text-body--small">{{ block.settings.author_title }}</span>
                  {%- endif -%}
                </div>
              </footer>
            {%- endif -%}
          </article>
        {%- endfor -%}

        {%- if section.settings.carousel -%}
          </div>
        {%- endif -%}

        {%- if section.settings.carousel -%}
          {%- render 'swiper-controls',
            type: section.settings.pagination_type,
            enable_arrows: section.settings.enable_arrows
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "shopify-section--testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show arrows",
      "default": true,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "default": "bullets",
      "label": "Type",
      "visible_if": "{{ section.settings.carousel }}",
      "options": [
        { "value": "", "label": "None" },
        { "value": "scrollbar", "label": "Scrollbar" },
        { "value": "bullets", "label": "Bullets" },
        { "value": "dynamic-bullets", "label": "Dynamic bullets" },
        { "value": "progressbar", "label": "Progressbar" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.carousel == false }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns mobile",
      "default": "1",
      "visible_if": "{{ section.settings.carousel == false }}",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" }
      ]
    },
    {
      "type": "range",
      "id": "slides_per_row_dt",
      "label": "Slides per row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "select",
      "id": "slides_per_row_mb",
      "label": "Slides per row (mobile)",
      "default": "1",
      "visible_if": "{{ section.settings.carousel }}",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" }
      ]
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to hide the rating."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This is the best purchase I've made all year. Couldn't be happier with the quality and service."
        },
        {
          "type": "header",
          "content": "Attribution"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Jane Doe"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Title / Company"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
