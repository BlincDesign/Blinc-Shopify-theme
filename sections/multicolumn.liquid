{%- style -%}
  #Multicolumn-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .multicolumn-section .multicolumn__column-content {
    padding: 1rem;
  }

  .multicolumn-section .multicolumn__column-icon {
    padding: 1rem 1rem 0;
  }

  .swiper-scrollbar, .swiper-pagination {
    position: relative !important;
    bottom: unset !important;
    left: unset !important;
    top: unset !important;
    right: unset !important;
    margin-block-start: 20px;
    margin-inline: auto;
    --swiper-scrollbar-sides-offset: 200px;
  }

  @media screen and (max-width: 749px) {
    #Multicolumn-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 1

  assign desktop_fraction = 100 | divided_by: columns_desktop
  assign mobile_fraction = 100 | divided_by: columns_mobile

  assign column_sizes = '(min-width: 750px) ' | append: desktop_fraction | append: 'vw, ' | append: mobile_fraction | append: 'vw'
-%}

<div
  id="Multicolumn-{{ section.id }}"
  class="multicolumn color-{{ section.settings.color_scheme }}"
>
  <div class="multicolumn__wrapper relative overflow-hidden {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank or section.settings.button != blank -%}
      <div class="multicolumn__header section__header flex flex-wrap justify-between items-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="multicolumn__heading heading heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.button != blank -%}
          {%- render 'button',
            label: section.settings.button,
            url: section.settings.button_link,
            button_style: section.settings.button_style
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="multicolumn__blocks overflow-hidden {% unless section.settings.carousel %} grid grid-columns grid-columns-mobile {% endunless %}"
      {% unless section.settings.carousel %}
        style="
          --grid-columns: {{ section.settings.columns }};
          --grid-columns-mobile: {{ section.settings.mobile_columns | plus: 0 }};
        "
      {% endunless %}
      {% if section.settings.carousel %}
        data-slider
        data-slider-config='
          {
            "loop": true,
            "slidesPerView": {{ section.settings.slides_per_row_mb | plus: 0 }},
            "spaceBetween": "var(--layout-gap)",
            "breakpoints": {
              "750": {
                "slidesPerView": {{ section.settings.slides_per_row_dt | minus: 0.5 }},
                "spaceBetween": "var(--layout-gap)"
              }
            }
          }
        '
      {% endif %}
    >
      {% if section.settings.carousel %}
        <div class="swiper-wrapper">
      {% endif %}

      {% for block in section.blocks %}
        {% capture column_content %}
          {% if block.settings.column_heading != blank
            or block.settings.column_description != blank
            or block.settings.column_btn_label != blank
          %}
            <div class="multicolumn__column-content gap-1 flex flex-column">

              {% if block.settings.column_heading != blank %}
                <h3 class="multicolumn__column-heading">
                  {{ block.settings.column_heading }}
                </h3>
              {% endif %}

              {% if block.settings.column_description != blank %}
                <div class="multicolumn__column-description">
                  {{ block.settings.column_description }}
                </div>
              {% endif %}

              {% if block.settings.column_btn_label != blank %}
                <div class="multicolumn__column-button">
                  {% render 'button',
                    label: block.settings.column_btn_label,
                    url: block.settings.column_btn_link,
                    button_style: block.settings.column_btn_style
                  %}
                </div>
              {% endif %}

            </div>
          {% endif %}
        {% endcapture %}

        {% case block.type %}
          {% when 'column' %}
            <article
              id="block-{{ block.id }}"
              class="multicolumn__column multicolumn__column--standard block-{{ block.type }} flex flex-column color-{{ section.settings.column_color_scheme }}{% if section.settings.carousel %} swiper-slide{% endif %}"
              {% if section.settings.carousel %}
                data-slide
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.column_video != blank or block.settings.column_image != blank %}
                <div class="multicolumn__column-media">
                  {% if block.settings.column_video != blank %}
                    {{
                      block.settings.column_video
                      | video_tag:
                        autoplay: true,
                        muted: true,
                        controls: false,
                        loop: true,
                        class: 'multicolumn__column-video'
                    }}
                  {% else %}
                    {% render 'image', image: block.settings.column_image, class: 'multicolumn__column-image', sizes: column_sizes %}
                  {% endif %}
                </div>
              {% endif %}

              {{ column_content }}
            </article>

          {% when 'logo-column' %}
            {% style %}
              #block-{{ block.id }} .multicolumn__column-icon-image {
                width: {{ block.settings.icon_size }}px;
                border-radius: {{ block.settings.icon_radius }}%;
              }
            {% endstyle %}

            <article
              id="block-{{ block.id }}"
              class="multicolumn__column multicolumn__column--logo block-{{ block.type }} flex flex-column color-{{ section.settings.column_color_scheme }}{% if section.settings.carousel %} swiper-slide{% endif %}"
              {% if section.settings.carousel %}
                data-slide
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="multicolumn__column-icon">
                {% if block.settings.custom_icon_image != blank %}
                  {% render 'image', image: block.settings.custom_icon_image, class: 'multicolumn__column-icon-image' %}

                {% elsif block.settings.native_icon_image != blank %}
                  {% render 'icon',
                    name: block.settings.native_icon_image,
                    size: block.settings.icon_size,
                    class: 'multicolumn__column-icon-svg'
                  %}

                {% else %}
                  {% liquid
                    assign fallback_icons = 'star,heart,truck,shield,leaf,gem,rocket,calendar' | split: ','
                    assign fallback_index = forloop.index0 | modulo: fallback_icons.size
                    assign fallback_icon = fallback_icons[fallback_index]
                  %}

                  {% render 'icon',
                    name: fallback_icon,
                    size: block.settings.icon_size,
                    class: 'multicolumn__column-icon-svg'
                  %}
                {% endif %}
              </div>

              {{ column_content }}
            </article>
        {% endcase %}
      {% endfor %}

      {% if section.settings.carousel %}
        </div>
      {% endif %}

      {% render 'swiper-pagination', type: section.settings.pagination_type, enable_arrows: section.settings.enable_arrows %}
    </div>
  </div>
</div>

{% schema %}
{
