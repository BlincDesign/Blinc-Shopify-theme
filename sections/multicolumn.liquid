{%- style -%}
  #Multicolumn-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #Multicolumn-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div id="Multicolumn-{{ section.id }}" class="multicolum-container">
  {%- if section.settings.heading != blank or section.settings.collection != blank -%}
    <div class="featured-collection__header flex flex-wrap justify-between items-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-collection__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.collection != blank -%}
        {%- render 'button', label: 'View all', url: section.settings.collection.url, button_style: 'link' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "multicolumn-section",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "XL" },
        { "value": "xxl", "label": "XXL" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "Multicolumn"
    }
  ]
}
{% endschema %}
