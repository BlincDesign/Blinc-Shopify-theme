{%- style -%}
  #Multicolumn-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .multicolumn-section .multicolumn__column-content {
    padding: 1rem;
  }

  @media screen and (max-width: 749px) {
    #Multicolumn-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div id="Multicolumn-{{ section.id }}" class="multicolumn color-{{ section.settings.color_scheme }}">
  <div class="multicolumn__wrapper overflow-hidden {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank or section.settings.collection != blank -%}
      <div class="multicolumn__header section__header flex flex-wrap justify-between items-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="multicolumn__heading heading heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.button != blank -%}
          {%- render 'button',
            label: section.settings.button,
            url: section.settings.button_link,
            button_style: section.settings.button_style
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div
      class="multicolumn-blocks overflow-hidden grid grid-columns grid-columns-mobile"
      style="--grid-columns: {{ section.settings.columns }}; --grid-columns-mobile:{{ section.settings.mobile_columns | plus: 0 }}"
      {%- if section.settings.carousel -%}
        data-slider
        data-slider-config='
          {
              "loop": "true",
              "slidesPerView": {{ section.settings.slides_per_row_mb | plus: 0 }},
              "spaceBetween": 10,
              "breakpoints": {
                    "750": {
                        "slidesPerView": {{ section.settings.slides_per_row_dt | minus: 0.5 }},
                        "spaceBetween": 10
                    }
                }
          }
        '
      {% endif %}
    >
      {%- if section.settings.carousel -%}<div class="swiper-wrapper">{% endif %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'column' %}
            <div
              class="multicolumn-column-block flex flex-column color-{{ section.settings.column_color_scheme }} {%- if section.settings.carousel -%} swiper-slide {% endif %}"
              {%- if section.settings.carousel -%}
                data-slide
              {% endif %}
            >
              {% if block.settings.column_video != blank or block.settings.column_image != blank %}
                <div class="multicolumn__column-media">
                  {% if block.settings.column_video != blank %}
                    {{
                      block.settings.column_video
                      | video_tag:
                        autoplay: true,
                        muted: true,
                        controls: false,
                        loop: true,
                        class: 'multicolumn_column_video'
                    }}
                  {% else %}
                    {%- render 'image', image: block.settings.column_image, class: 'multicolumn_column_image' -%}
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.column_heading != blank
                or block.settings.column_description != blank
                or block.settings.column_btn_label != blank
              %}
                <article class="multicolumn__column-content gap-1 flex flex-column ">
                  {% if block.settings.column_heading != blank %}
                    <h3 class="multicolumn__column-heading">
                      {{ block.settings.column_heading }}
                    </h3>
                  {% endif %}

                  {% if block.settings.column_description != blank %}
                    <div class="multicolumn__column-description">
                      {{ block.settings.column_description }}
                    </div>
                  {% endif %}

                  {%- if block.settings.column_btn_label != blank -%}
                    <div class="multicolumn__column-btn">
                      {%- render 'button',
                        label: block.settings.column_btn_label,
                        url: block.settings.column_btn_link,
                        button_style: block.settings.column_btn_style
                      -%}
                    </div>
                  {%- endif -%}
                </article>
              {%- endif -%}
            </div>
          {% when 'logo-list' %}

        {% endcase %}
      {% endfor %}
      {%- if section.settings.carousel -%}</div>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "multicolumn-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "video",
          "id": "column_video",
          "label": "Video",
          "info": "If video is added image wont be displayed"
        },
        {
          "type": "image_picker",
          "id": "column_image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "inline_richtext",
          "id": "column_heading",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "richtext",
          "id": "column_description",
          "label": "Description",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "column_btn_label",
          "label": "Label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "column_btn_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "column_btn_style",
          "default": "primary",
          "label": "Button style",
          "options": [
            {
              "label": "Primary",
              "value": "primary"
            },
            {
              "label": "Secondary",
              "value": "secondary"
            },
            {
              "label": "Link",
              "value": "link"
            }
          ]
        }
      ]
    },
    {
      "type": "logo-column",
      "name": "Logo column",
      "settings": []
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Multicolumn"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xl", "label": "XL" },
        { "value": "xxl", "label": "XXL" }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "default": "link",
      "label": "Button style",
      "options": [
        {
          "label": "Primary",
          "value": "primary"
        },
        {
          "label": "Secondary",
          "value": "secondary"
        },
        {
          "label": "Link",
          "value": "link"
        }
      ]
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "color_scheme",
      "id": "column_color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "carousel",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.carousel == false }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns mobile",
      "default": "2",
      "visible_if": "{{ section.settings.carousel == false }}",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "slides_per_row_dt",
      "label": "Slides per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.carousel }}"
    },
    {
      "type": "select",
      "id": "slides_per_row_mb",
      "label": "Slides per row (mobile)",
      "default": "2",
      "visible_if": "{{ section.settings.carousel }}",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "2",
          "value": "2"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        {
          "value": "full-width",
          "label": "Full Width"
        },
        {
          "value": "container-padded",
          "label": "Full Width (Padded)"
        },
        {
          "value": "container-standard",
          "label": "Standard"
        },
        {
          "value": "container-narrow",
          "label": "Narrow"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
