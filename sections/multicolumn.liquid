        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "column_btn_label",
          "label": "Label",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "column_btn_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "column_btn_style",
          "default": "primary",
          "label": "Button style",
          "options": [
            {
              "label": "Primary",
              "value": "primary"
            },
            {
              "label": "Secondary",
              "value": "secondary"
            },
            {
              "label": "Link",
              "value": "link"
            }
          ]
        }
      ]
    },
    {
      "type": "logo-column",
      "name": "Logo column",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "image_picker",
          "id": "custom_icon_image",
          "label": "Custom icon",
          "info": "Please use a 150x150 svg or png image to get the best results"
