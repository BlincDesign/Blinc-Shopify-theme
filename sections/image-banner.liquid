{% style %}
  #Banner-{{ section.id }} {
  position: relative;
}
#Banner-{{ section.id }} img {
  display: block;
  width: 100%;
  height: auto;
}

#Banner-{{ section.id }}::after {
  content: '';
  position: absolute;
  inset: 0;
  background: #000;
  pointer-events: none;
}

  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{% endstyle %}

<div
  id="Banner-{{ section.id }}"
  class="{% if section.settings.image != blank and section.settings.image_2 != blank %}flex{% endif %}"
>
  {% if section.settings.image != blank %}
    <div class="flex-grow">
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}

  {% if section.settings.image_2 != blank %}
    <div class="flex-grow">
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}
</div>



{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "shopify-section--image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image1"
    },
    {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2"
    },
    {
        "type": "range",
        "id": "image_overlay_opacity",
        "min": 0,
        "max": 100,
        "step": 10,
        "unit": "%",
        "label": "Overlay Opacity",
        "default": 0
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}