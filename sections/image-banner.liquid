{% liquid
  if section.settings.image != blank
    assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
  endif
%}

{% style %}
      #Banner-{{ section.id }} {
        position: relative;
      }

      #Banner-{{ section.id }} img {
        display: block;
        width: 100%;
        object-fit: cover;
      }
      #Banner-{{ section.id }}::after {
        content: '';
        position: absolute;
        inset: 0;
        background: #000;
        pointer-events: none;
        opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
      }

      {% if section.settings.image_height == 'adapt' %}
        #Banner-{{ section.id }} img {
          height: auto;
        }

      {% elsif section.settings.image_height == 'small' %}
        #Banner-{{ section.id }} img {
          height: 420px;
          object-fit: cover;
        }

      {% elsif section.settings.image_height == 'medium' %}
        #Banner-{{ section.id }} img {
          height: 560px;
          object-fit: cover;
        }

      {% elsif section.settings.image_height == 'large' %}
        #Banner-{{ section.id }} img {
          height: 720px;
          object-fit: cover;
        }
      {% endif %}

      .banner__content {
      position: absolute;
      inset: 0;
      z-index: 2;
      padding: 45px;
      margin: 0 auto;

    }
    .banner__box {
      background: white;
      padding: 40px;
      row-gap: 20px;
      max-width: 710px;
      min-width: 450px;
  }
  .btns a {
      padding: 15px 35px;
      background: #959191;
      color: #fff;
  }
{% endstyle %}

<div
  id="Banner-{{ section.id }}"
  class="{% if section.settings.image != blank and section.settings.image_2 != blank %}flex{% endif %}"
>
  {% if section.settings.image != blank %}
    <div class="flex-grow">
      {{ section.settings.image | image_url: width: 3840 | image_tag: loading: 'lazy', height: image_height }}
    </div>
  {% endif %}

  {% if section.settings.image_2 != blank %}
    <div class="flex-grow">
      {{ section.settings.image_2 | image_url: width: 3840 | image_tag: loading: 'lazy', height: image_height }}
    </div>
  {% endif %}

  {% assign content_position = section.settings.desktop_content_position | split: '-' %}

  {% if section.blocks.size > 0 %}
  <div
    class="banner__content flex items-{{ content_position[0] }} justify-{{ content_position[1] }}"
  >
    <div class="flex flex-column banner__box text-{{ section.settings.content_alignment }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <h2>
              {{ block.settings.heading }}
            </h2>

          {% when 'text' %}
            <div {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {% when 'buttons' %}
            <div class="flex gap-1 btns justify-{{ section.settings.content_alignment }}">
              {% if block.settings.button_label_1 != blank %}
                <a href="{{ block.settings.button_link_1 }}">
                  {{ block.settings.button_label_1 }}
                </a>
              {% endif %}

              {% if block.settings.button_label_2 != blank %}
                <a href="{{ block.settings.button_link_2 }}">
                  {{ block.settings.button_label_2 }}
                </a>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>


{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt for first image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Image Height"
    },
    {
      "type": "header",
      "content": "Content",
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "start-left",
          "label": "Top left"
        },
        {
          "value": "start-center",
          "label": "Top center"
        },
        {
          "value": "start-right",
          "label": "Top right"
        },
        {
          "value": "center-left",
          "label": "Middle left"
        },
        {
          "value": "center-center",
          "label": "Middle center"
        },
        {
          "value": "center-right",
          "label": "Middle right"
        },
        {
          "value": "end-left",
          "label": "Bottom left"
        },
        {
          "value": "end-center",
          "label": "Bottom center"
        },
        {
          "value": "end-right",
          "label": "Bottom right"
        }
      ],
      "default": "center-center",
      "label": "Position"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Alignment"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Image banner",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "First button label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "First button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Second button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}
