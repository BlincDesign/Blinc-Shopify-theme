<div class="{% if section.settings.image != blank and section.settings.image_2 != blank %}flex{% endif %}">
  {% if section.settings.image != blank %}
    <div class="{% if section.settings.image_2 != blank %}flex-grow{% endif %}">
      {{
        section.settings.image
        | image_url: width: 1000
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}

  {% if section.settings.image_2 != blank %}
    <div class="flex-grow">
      {{
        section.settings.image_2
        | image_url: width: 1000
        | image_tag: loading: 'lazy'
      }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "shopify-section--image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image1"
    },
    {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}