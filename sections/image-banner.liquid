<div>
  <div>
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag: loading: 'lazy'
      }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "shopify-section--image-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Select an image"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}