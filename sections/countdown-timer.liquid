{%- style -%}
  #shopify-section-{{ section.id }} .countdown-timer {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .countdown-timer {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>

<div class="countdown-timer color-{{ section.settings.color_scheme }}">
  <div class="countdown-timer__wrapper {{ section.settings.container_width }} flex flex-column items-center text-center">
    {%- if section.settings.heading != blank -%}
      <h2 class="countdown-timer__heading heading heading--{{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="countdown-timer__text text-body">{{ section.settings.text }}</div>
    {%- endif -%}

    <countdown-timer
      class="countdown-timer__display"
      data-target="{{ section.settings.target_date }}"
      data-completion-behavior="{{ section.settings.completion_behavior }}"
      data-completion-message="{{ section.settings.completion_message | escape }}"
    >
      <div class="countdown-timer__units flex justify-center" aria-hidden="true">
        <div class="countdown-timer__unit flex flex-column items-center">
          <span class="countdown-timer__value" data-days>00</span>
          <span class="countdown-timer__label text-body--small">Days</span>
        </div>
        <div class="countdown-timer__unit flex flex-column items-center">
          <span class="countdown-timer__value" data-hours>00</span>
          <span class="countdown-timer__label text-body--small">Hours</span>
        </div>
        <div class="countdown-timer__unit flex flex-column items-center">
          <span class="countdown-timer__value" data-minutes>00</span>
          <span class="countdown-timer__label text-body--small">Minutes</span>
        </div>
        <div class="countdown-timer__unit flex flex-column items-center">
          <span class="countdown-timer__value" data-seconds>00</span>
          <span class="countdown-timer__label text-body--small">Seconds</span>
        </div>
      </div>

      <p class="visually-hidden" data-countdown-status role="status" aria-live="polite"></p>
    </countdown-timer>

    {%- if section.settings.button_label != blank -%}
      <div class="countdown-timer__buttons">
        {%- render 'button',
          label: section.settings.button_label,
          url: section.settings.button_link,
          button_style: 'primary'
        -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Countdown timer",
  "tag": "section",
  "class": "shopify-section--countdown-timer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sale ends soon"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target date and time",
      "default": "2026-12-31T23:59:59",
      "info": "Format: YYYY-MM-DDTHH:MM:SS. Uses the visitor's local timezone."
    },
    {
      "type": "select",
      "id": "completion_behavior",
      "label": "When the countdown ends",
      "options": [
        { "value": "message", "label": "Show a message" },
        { "value": "zero", "label": "Show 00:00:00:00" },
        { "value": "hide", "label": "Hide the section" }
      ],
      "default": "message"
    },
    {
      "type": "text",
      "id": "completion_message",
      "label": "Completion message",
      "default": "This offer has ended.",
      "visible_if": "{{ section.settings.completion_behavior == 'message' }}"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Countdown timer"
    }
  ]
}
{% endschema %}
