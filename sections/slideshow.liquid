{%- liquid
  assign should_loop = false
  if section.blocks.size > 1
    assign should_loop = true
  endif

  case section.settings.slide_height
    when 'small'
      assign height_value = '500px'
      assign height_value_mobile = '420px'
    when 'large'
      assign height_value = '800px'
      assign height_value_mobile = '560px'
    when 'full'
      assign height_value = '100svh'
      assign height_value_mobile = '100svh'
    when 'adapt'
      assign height_value = null
      assign height_value_mobile = null
    else
      assign height_value = '650px'
      assign height_value_mobile = '480px'
  endcase

  assign is_above_fold_section = false
  if section.index <= 2
    assign is_above_fold_section = true
  endif
-%}

{%- style -%}
  #Slideshow-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  {% if height_value %}
    #Slideshow-{{ section.id }} .hero__slide {
      height: {{ height_value }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #Slideshow-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }

    {% if height_value_mobile %}
      #Slideshow-{{ section.id }} .hero__slide {
        height: {{ height_value_mobile }};
      }
    {% endif %}
  }
{%- endstyle -%}

<div id="Slideshow-{{ section.id }}" class="hero color-{{ section.settings.color_scheme }}">
  <div class="hero__wrapper relative overflow-hidden {{ section.settings.container_width }}">
    {%- if section.blocks.size > 0 -%}
      <div
        class="hero__slider"
        data-slider
        data-slider-config='
          {
            "loop": {{ should_loop }},
            "slidesPerView": 1,
            "effect": "fade",
            "fadeEffect": { "crossFade": true }
            {% if section.settings.autoplay %}
              ,"autoplay": {
                "delay": {{ section.settings.autoplay_speed | times: 1000 }},
                "disableOnInteraction": false
              }
            {% endif %}
          }
        '
        role="region"
        aria-roledescription="carousel"
        aria-label="Featured slides"
      >
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign is_priority = false
              if is_above_fold_section and forloop.index == 1
                assign is_priority = true
              endif
              assign img_loading = 'lazy'
              assign img_fetchpriority = 'auto'
              if is_priority
                assign img_loading = 'eager'
                assign img_fetchpriority = 'high'
              endif
              assign slide_aspect_ratio = block.settings.image.aspect_ratio | default: 2.5
            -%}
            <div
              class="hero__slide swiper-slide relative flex color-{{ block.settings.color_scheme }}"
              data-slide
              {% if section.settings.slide_height == 'adapt' %}
                style="aspect-ratio: {{ slide_aspect_ratio }};"
              {% endif %}
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} of {{ forloop.length }}"
              {{ block.shopify_attributes }}
            >
              <div class="hero__media absolute-fill">
                {%- if block.settings.video != blank -%}
                  {%- render 'video',
                    video: block.settings.video,
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    class: 'hero__media-asset fit-cover'
                  -%}
                {%- else -%}
                  {%- render 'image',
                    image: block.settings.image,
                    class: 'hero__media-asset',
                    width: 1600,
                    sizes: '100vw',
                    loading: img_loading,
                    fetchpriority: img_fetchpriority
                  -%}
                {%- endif -%}

                {%- if section.settings.overlay_opacity > 0 -%}
                  <div
                    class="media-overlay absolute-fill"
                    style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
                  ></div>
                {%- endif -%}
              </div>

              {%- capture slide_content -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="hero__heading heading heading--{{ block.settings.heading_size }}">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="hero__text text-body">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
                  <div class="hero__buttons flex flex-wrap items-center">
                    {%- if block.settings.button_1_label != blank -%}
                      {%- render 'button',
                        label: block.settings.button_1_label,
                        url: block.settings.button_1_link,
                        button_style: block.settings.button_1_style
                      -%}
                    {%- endif -%}
                    {%- if block.settings.button_2_label != blank -%}
                      {%- render 'button',
                        label: block.settings.button_2_label,
                        url: block.settings.button_2_link,
                        button_style: block.settings.button_2_style
                      -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {%- render 'overlay-content',
                content: slide_content,
                position: section.settings.content_position,
                text_alignment: section.settings.text_alignment,
                class: 'hero__content'
              -%}
            </div>
          {%- endfor -%}
        </div>

        {%- render 'swiper-controls',
          type: section.settings.pagination_type,
          enable_arrows: section.settings.enable_arrows
        -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "shopify-section--hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "slide_height",
      "label": "Slide height",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "center-left", "label": "Middle left" },
        { "value": "center-center", "label": "Middle center" },
        { "value": "center-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "center-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "enable_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Type",
      "default": "bullets",
      "options": [
        { "value": "", "label": "None" },
        { "value": "bullets", "label": "Bullets" },
        { "value": "dynamic-bullets", "label": "Dynamic bullets" },
        { "value": "progressbar", "label": "Progressbar" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "full-width",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Overrides the image when set. Plays muted, looped, without controls."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Announce your brand"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "xl", "label": "XL" },
            { "value": "xxl", "label": "XXL" }
          ],
          "default": "xl"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Give customers details about the banner image(s) or content on the template.</p>"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Slide color scheme",
          "default": "scheme-1"
        },
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "link", "label": "Link" }
          ]
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_2_style",
          "label": "Button style",
          "default": "link",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "link", "label": "Link" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
