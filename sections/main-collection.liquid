{%- comment -%}
  Main collection section. Renders an optional collection banner/description,
  a sort-by control, and the product grid (reusing snippets/product-grid.liquid
  so cards stay identical to every other grid in the theme), with pagination.

  Sorting needs JS only because a native <select> has no way to submit itself
  on change without inline JS (disallowed) - see the <collection-sort> custom
  element in assets/collection.js. Faceted filtering isn't included; this
  section covers sort + pagination only.
{%- endcomment -%}

{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .main-collection {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="main-collection color-{{ section.settings.color_scheme }}">
  {%- if section.settings.show_collection_image and collection.image -%}
    <div class="main-collection__banner">
      {%- render 'image',
        image: collection.image,
        width: 1600,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
      -%}
    </div>
  {%- endif -%}

  <div class="main-collection__wrapper {{ section.settings.container_width }}">
    <div class="main-collection__header flex flex-wrap items-center justify-between">
      <div class="main-collection__heading-group">
        <h1 class="main-collection__title heading heading--xl">{{ collection.title }}</h1>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="main-collection__description text-body rte-column">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_sorting and collection.products.size > 0 -%}
        <collection-sort class="main-collection__sort">
          <label class="visually-hidden" for="SortBy-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label>
          <select name="sort_by" id="SortBy-{{ section.id }}" class="main-collection__sort-select" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </collection-sort>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        {%- render 'product-grid', products: collection.products -%}
      {%- else -%}
        <p class="main-collection__empty text-body text-center">{{ 'collections.empty' | t }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="main-collection__pagination flex items-center justify-center" role="navigation" aria-label="{{ 'collections.pagination.title' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="main-collection__pagination-link items-center justify-center" aria-label="{{ 'collections.pagination.previous' | t }}">
              {%- render 'icon', name: 'chevron-left' -%}
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="main-collection__pagination-link items-center justify-center">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="main-collection__pagination-link main-collection__pagination-link--current items-center justify-center" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="main-collection__pagination-link items-center justify-center">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="main-collection__pagination-link items-center justify-center" aria-label="{{ 'collections.pagination.next' | t }}">
              {%- render 'icon', name: 'chevron-right' -%}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{%- if section.settings.enable_sorting -%}
  <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "shopify-section--main-collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection banner"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "container-padded", "label": "Full width (padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Main collection"
    }
  ]
}
{% endschema %}
