{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign aspect_ratio = '1/1'
    when 'portrait'
      assign aspect_ratio = '3/4'
    else
      assign aspect_ratio = '4/3'
  endcase

  assign mobile_columns = section.settings.mobile_columns | plus: 0
  assign desktop_fraction = 100 | divided_by: section.settings.columns | round: 2
  assign mobile_fraction = 100 | divided_by: mobile_columns | round: 2
  assign column_sizes = '(min-width: 750px) ' | append: desktop_fraction | append: 'vw, ' | append: mobile_fraction | append: 'vw'

  assign img_loading = 'lazy'
  assign img_fetchpriority = 'auto'
  if section.index <= 2
    assign img_loading = 'eager'
    assign img_fetchpriority = 'high'
  endif
-%}

{%- style -%}
  #CollectionList-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #CollectionList-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div id="CollectionList-{{ section.id }}" class="collection-list color-{{ section.settings.color_scheme }}">
  <div class="collection-list__wrapper {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="collection-list__header section__header text-center">
        <h2 class="collection-list__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="collection-list__grid grid grid-columns grid-columns-mobile"
        style="
          --grid-columns: {{ section.settings.columns }};
          --grid-columns-mobile: {{ mobile_columns }};
        "
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign card_title = block.settings.title | default: collection.title
            assign card_image = block.settings.image | default: collection.featured_image
            assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1
            assign placeholder_name = 'collection-' | append: placeholder_index
          -%}
          <a
            href="{{ collection.url | default: '#' }}"
            class="collection-list__item flex flex-column color-{{ section.settings.card_color_scheme }}"
            {{ block.shopify_attributes }}
          >
            {%- if card_image != blank -%}
              {%- render 'image',
                image: card_image,
                aspect_ratio: aspect_ratio,
                width: 600,
                sizes: column_sizes,
                class: 'collection-list__image',
                loading: img_loading,
                fetchpriority: img_fetchpriority
              -%}
            {%- else -%}
              <div class="collection-list__image-placeholder" style="aspect-ratio: {{ aspect_ratio }};">
                {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- if card_title != blank -%}
              <h3 class="collection-list__title heading heading--small">{{ card_title }}</h3>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "class": "shopify-section--collection-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection's featured image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Overrides the collection's title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
