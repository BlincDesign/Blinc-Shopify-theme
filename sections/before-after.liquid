{%- liquid
  case section.settings.aspect_ratio
    when 'square'
      assign aspect_ratio = '1/1'
    when 'portrait'
      assign aspect_ratio = '3/4'
    else
      assign aspect_ratio = '16/9'
  endcase

  assign img_loading = 'lazy'
  assign img_fetchpriority = 'auto'
  if section.index <= 2
    assign img_loading = 'eager'
    assign img_fetchpriority = 'high'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .before-after {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .before-after {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'before-after.js' | asset_url }}" defer="defer"></script>

<div class="before-after color-{{ section.settings.color_scheme }}">
  <div class="before-after__wrapper {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="before-after__header section__header text-center">
        <h2 class="before-after__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    <before-after-slider class="before-after__slider" data-initial="{{ section.settings.initial_position }}">
      <div class="before-after__frame relative overflow-hidden" style="aspect-ratio: {{ aspect_ratio }};">
        <div class="before-after__image before-after__image--before absolute-fill">
          {%- if section.settings.before_image != blank -%}
            {%- render 'image',
              image: section.settings.before_image,
              width: 1600,
              sizes: '(min-width: 750px) 1000px, 100vw',
              loading: img_loading,
              fetchpriority: img_fetchpriority
            -%}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg fit-cover' }}
          {%- endif -%}
        </div>

        <div class="before-after__image before-after__image--after absolute-fill">
          {%- if section.settings.after_image != blank -%}
            {%- render 'image',
              image: section.settings.after_image,
              width: 1600,
              sizes: '(min-width: 750px) 1000px, 100vw',
              loading: img_loading,
              fetchpriority: img_fetchpriority
            -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg fit-cover' }}
          {%- endif -%}
        </div>

        {%- if section.settings.before_label != blank -%}
          <span class="before-after__badge before-after__badge--before">{{ section.settings.before_label }}</span>
        {%- endif -%}

        {%- if section.settings.after_label != blank -%}
          <span class="before-after__badge before-after__badge--after">{{ section.settings.after_label }}</span>
        {%- endif -%}

        <div
          class="before-after__handle"
          role="slider"
          tabindex="0"
          aria-label="{{ 'general.before_after.handle_label' | t }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="{{ section.settings.initial_position }}"
          aria-orientation="horizontal"
        >
          <span class="before-after__handle-icon" aria-hidden="true">
            {%- render 'icon', name: 'left-caret', size: 12 -%}
            {%- render 'icon', name: 'right-caret', size: 12 -%}
          </span>
        </div>
      </div>
    </before-after-slider>
  </div>
</div>

{% schema %}
{
  "name": "Before / After",
  "tag": "section",
  "class": "shopify-section--before-after",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Before"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Label",
      "default": "Before"
    },
    {
      "type": "header",
      "content": "After"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "Label",
      "default": "After"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "landscape", "label": "16:9" },
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "3:4" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Before / After"
    }
  ]
}
{% endschema %}
