{%- style -%}
  #LogoList-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #LogoList-{{ section.id }} .logo-list__logo {
    max-height: {{ section.settings.logo_height }}px;
  }

  #LogoList-{{ section.id }} .marquee__track {
    animation-duration: {{ section.settings.marquee_speed }}s;
    gap: {{ section.settings.item_gap }}px;
  }

  #LogoList-{{ section.id }} .logo-list__item {
    margin-inline-end: {{ section.settings.item_gap }}px;
  }

  @media screen and (max-width: 749px) {
    #LogoList-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }

    #LogoList-{{ section.id }} .logo-list__logo {
      max-height: {{ section.settings.logo_height | times: 0.75 | round }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign img_loading = 'lazy'
  assign img_fetchpriority = 'auto'
  if section.index <= 2
    assign img_loading = 'eager'
    assign img_fetchpriority = 'high'
  endif
-%}

<div id="LogoList-{{ section.id }}" class="logo-list color-{{ section.settings.color_scheme }}">
  <div class="logo-list__wrapper {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="logo-list__header section__header flex justify-center">
        <h2 class="logo-list__heading heading heading--{{ section.settings.heading_size }} text-center">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.layout_mode == 'marquee' -%}
        <div class="logo-list__marquee marquee" role="region" aria-label="{{ section.settings.heading | default: 'Logos' | escape }}">
          <div class="marquee__track flex items-center">
            {%- for i in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign hidden_copy = false
                  if i == 2
                    assign hidden_copy = true
                  endif
                -%}
                <div
                  class="logo-list__item flex items-center justify-center"
                  {% if hidden_copy %}
                    aria-hidden="true"
                  {% else %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {%- if block.settings.link != blank and hidden_copy == false -%}
                    <a href="{{ block.settings.link }}" class="logo-list__link" aria-label="{{ block.settings.name | default: block.settings.logo.alt | escape }}">
                  {%- endif -%}

                  {%- render 'image',
                    image: block.settings.logo,
                    alt: block.settings.name,
                    width: 200,
                    sizes: '160px',
                    fill: false,
                    class: 'logo-list__logo',
                    loading: img_loading,
                    fetchpriority: img_fetchpriority
                  -%}

                  {%- if block.settings.link != blank and hidden_copy == false -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div
          class="logo-list__grid grid grid-columns grid-columns-mobile items-center"
          style="
            --grid-columns: {{ section.settings.columns_desktop }};
            --grid-columns-mobile: {{ section.settings.columns_mobile }};
          "
        >
          {%- for block in section.blocks -%}
            <div class="logo-list__item flex items-center justify-center" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="logo-list__link" aria-label="{{ block.settings.name | default: block.settings.logo.alt | escape }}">
              {%- endif -%}

              {%- render 'image',
                image: block.settings.logo,
                alt: block.settings.name,
                width: 200,
                sizes: '(min-width: 750px) 200px, 120px',
                fill: false,
                class: 'logo-list__logo',
                loading: img_loading,
                fetchpriority: img_fetchpriority
              -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "shopify-section--logo-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured in"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "marquee", "label": "Marquee" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "visible_if": "{{ section.settings.layout_mode == 'grid' }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns mobile",
      "default": "3",
      "visible_if": "{{ section.settings.layout_mode == 'grid' }}",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "Lower is faster.",
      "visible_if": "{{ section.settings.layout_mode == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Space between logos",
      "min": 16,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-standard",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Used as alt text and, if linked, as the accessible link label."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
