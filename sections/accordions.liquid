{%- style -%}
  #shopify-section-{{ section.id }} .accordions {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .accordions {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'accordion.js' | asset_url }}" defer="defer"></script>

<div class="accordions color-{{ section.settings.color_scheme }}">
  <div class="accordions__wrapper {{ section.settings.container_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="accordions__header section__header text-center">
        <h2 class="accordions__heading heading heading--{{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="accordions__layout flex mobile-flex-column gap-1">
        {%- if section.settings.enable_toc -%}
          <nav class="accordions__toc" aria-label="{{ section.settings.toc_heading | default: 'Table of contents' }}">
            {%- if section.settings.toc_heading != blank -%}
              <h3 class="accordions__toc-heading heading heading--small">{{ section.settings.toc_heading }}</h3>
            {%- endif -%}
            <ol class="accordions__toc-list">
              {%- for block in section.blocks -%}
                {%- if block.settings.heading != blank -%}
                  <li class="accordions__toc-item">
                    <a
                      class="accordions__toc-link"
                      href="#AccordionTrigger-{{ block.id }}"
                      data-toc-link
                    >
                      {{ block.settings.heading }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </nav>
        {%- endif -%}

        <accordion-group
          class="accordions__list flex-grow"
          {% if section.settings.allow_multiple %}
            data-allow-multiple
          {% endif %}
        >
          {%- for block in section.blocks -%}
            {%- render 'accordion-item',
              id: block.id,
              title: block.settings.heading,
              content: block.settings.content,
              open: block.settings.open,
              attributes: block.shopify_attributes
            -%}
          {%- endfor -%}
        </accordion-group>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Accordions",
  "tag": "section",
  "class": "shopify-section--accordions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "Allow multiple items open at once",
      "default": false
    },
    {
      "type": "header",
      "content": "Table of contents"
    },
    {
      "type": "checkbox",
      "id": "enable_toc",
      "label": "Enable table of contents",
      "default": false
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Table of contents heading",
      "default": "On this page",
      "visible_if": "{{ section.settings.enable_toc }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-narrow",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Accordion item"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Share details about this item, such as sizing, shipping, or product care instructions.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordions",
      "blocks": [
        { "type": "accordion_item" },
        { "type": "accordion_item" },
        { "type": "accordion_item" }
      ]
    }
  ]
}
{% endschema %}
