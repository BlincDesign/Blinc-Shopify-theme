{%- style -%}
  #shopify-section-{{ section.id }} .newsletter-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .newsletter-section {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
  }
{%- endstyle -%}

<div class="newsletter-section color-{{ section.settings.color_scheme }}">
  <div class="newsletter-section__wrapper {{ section.settings.container_width }} flex flex-column items-center text-center">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="newsletter-section__header section__header text-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter-section__heading heading heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="newsletter-section__text text-body">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- render 'newsletter',
      show_name: section.settings.show_name,
      show_email: true,
      show_consent: section.settings.show_consent
    -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "shopify-section--newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Be the first to know about new arrivals, sales, and exclusive offers.</p>"
    },
    {
      "type": "header",
      "content": "Fields"
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_consent",
      "label": "Show marketing consent checkbox",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container Width",
      "default": "container-narrow",
      "options": [
        { "value": "full-width", "label": "Full Width" },
        { "value": "container-padded", "label": "Full Width (Padded)" },
        { "value": "container-standard", "label": "Standard" },
        { "value": "container-narrow", "label": "Narrow" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing Desktop"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "default": 48
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing Mobile"
    },
    {
      "type": "number",
      "id": "padding_top_m",
      "label": "Top spacing (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "padding_bottom_m",
      "label": "Bottom spacing (px)",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
