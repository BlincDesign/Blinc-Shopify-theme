{%- liquid
  assign width_class = 'container-standard'
  if section.settings.enable_full_width
    assign width_class = 'header__wrapper--full-width'
  endif
-%}

<header
  class="header color-{{ section.settings.color_scheme }} header--{{ section.settings.header_layout }} header--logo-{{ section.settings.logo_position }} header--mobile-logo-{{ section.settings.mobile_logo_position }}"
  data-sticky-type="{{ section.settings.sticky_header }}" data-logo-max-height="{{ section.settings.logo_max_height }}"
data-sticky-logo-max-height="{{ section.settings.sticky_logo_max_height }}"
  style="--header-padding-top: {{ section.settings.padding_top }}px; --header-padding-bottom: {{ section.settings.padding_bottom }}px; --logo-max-width: {{ section.settings.logo_max_width }}px; --logo-max-height: {{ section.settings.logo_max_height }}px;"
>
  {%- if section.settings.header_layout == 'two-row' -%}
    <div class="header__row header__row--utility">
      <div class="header__row-inner {{ width_class }} flex items-center justify-between mobile-justify-end">
        {%- if section.settings.secondary_menu.links.size > 0 -%}
          <nav class="header__nav header__nav--secondary" aria-label="Secondary">
            <ul class="header__nav-list flex items-center">
              {%- render 'menu-links',
                menu: section.settings.secondary_menu,
                color_scheme: section.settings.menu_color_scheme
              -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- render 'header-icons',
          enable_country_selector: section.settings.enable_country_selector,
          enable_language_selector: section.settings.enable_language_selector,
          enable_customer_account_icon: section.settings.enable_customer_account_icon
        -%}
      </div>
    </div>

    <div class="header__row header__row--main">
      <div class="header__row-inner {{ width_class }} flex items-center mobile-justify-end">
        <div class="header__logo">
          <a href="{{ routes.root_url }}">
            {%- if section.settings.logo != blank -%}
              {%- render 'image',
                image: section.settings.logo,
                alt: shop.name,
                width: 600,
                sizes: '200px',
                fill: false,
                loading: 'eager',
                fetchpriority: 'high'
              -%}
            {%- else -%}
              <span class="header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- if section.settings.menu.links.size > 0 -%}
          <nav class="header__nav" aria-label="Primary">
            <ul class="header__nav-list flex items-center">
              {%- render 'menu-links', menu: section.settings.menu, color_scheme: section.settings.menu_color_scheme -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.menu.links.size > 0 or section.settings.secondary_menu.links.size > 0 -%}
          <details class="header__mobile-nav">
            <summary class="header__mobile-nav-toggle">{{ 'general.header.menu' | t }}</summary>
            <ul class="header__mobile-nav-list color-{{ section.settings.menu_color_scheme }}">
              {%- render 'menu-links', menu: section.settings.menu, color_scheme: section.settings.menu_color_scheme -%}
              {%- if section.settings.secondary_menu.links.size > 0 -%}
                <li class="header__mobile-nav-divider" role="separator"></li>
                {%- render 'menu-links',
                  menu: section.settings.secondary_menu,
                  color_scheme: section.settings.menu_color_scheme
                -%}
              {%- endif -%}
            </ul>
          </details>
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    <div class="header__wrapper items-center {{ width_class }}">
      <div class="header__logo">
        <a href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {%- render 'image',
              image: section.settings.logo,
              alt: shop.name,
              width: 600,
              sizes: '200px',
              fill: false,
              loading: 'eager',
              fetchpriority: 'high'
            -%}
          {%- else -%}
            <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      {%- if section.settings.menu.links.size > 0 -%}
        <nav class="header__nav" aria-label="Primary">
          <ul class="header__nav-list flex items-center">
            {%- render 'menu-links', menu: section.settings.menu, color_scheme: section.settings.menu_color_scheme -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- render 'header-icons',
        enable_country_selector: section.settings.enable_country_selector,
        enable_language_selector: section.settings.enable_language_selector,
        enable_customer_account_icon: section.settings.enable_customer_account_icon
      -%}

      {%- if section.settings.menu.links.size > 0 -%}
        <details class="header__mobile-nav">
          <summary class="header__mobile-nav-toggle">{{ 'general.header.menu' | t }}</summary>
          <ul class="header__mobile-nav-list color-{{ section.settings.menu_color_scheme }}">
            {%- render 'menu-links', menu: section.settings.menu, color_scheme: section.settings.menu_color_scheme -%}
          </ul>
        </details>
      {%- endif -%}
    </div>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "shopify-section--header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "number",
      "id": "logo_max_width",
      "label": "Logo max width (desktop px)",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo max height (desktop)",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "sticky_logo_max_height",
      "label": "Sticky logo max height",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "info": "Only applies to the one-row header layout. The two-row layout always centers the logo.",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "mobile_logo_position",
      "label": "Mobile logo position",
      "info": "Only applies to the one-row header layout. The two-row layout always centers the logo on mobile.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Secondary menu"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Secondary menu",
      "info": "Only shown when Header layout below is set to Two rows."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "info": "Two rows adds a utility row (secondary menu + account/cart icons) above the logo and primary menu.",
      "options": [
        { "value": "one-row", "label": "One row" },
        { "value": "two-row", "label": "Two rows" }
      ],
      "default": "one-row"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "Enable full-width header",
      "default": false
    },
    {
      "type": "select",
      "id": "sticky_header",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "on-scroll-up", "label": "On scroll up" },
        { "value": "always", "label": "Always" },
        { "value": "always-reduce-logo-size", "label": "Always, reduce logo size" }
      ],
      "default": "on-scroll-up"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Header color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "menu_color_scheme",
      "label": "Menu color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Localization"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Enable country/region selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Enable language selector",
      "default": false
    },
    {
      "type": "header",
      "content": "Customer account"
    },
    {
      "type": "checkbox",
      "id": "enable_customer_account_icon",
      "label": "Show customer account icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
